<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View purchase.order.advance.payment form -->
    <record id="view_purchase_order_advance_payment_form" model="ir.ui.view">
        <field name="name">view.purchase.order.advance.payment.form</field>
        <field name="model">purchase.order.advance.payment</field>
        <field name="arch" type="xml">
            <form string="Purchase Order Advance Payment">
                <div class="d-inline-flex align-items-center alert alert-warning fw-bold" role="alert">
                    Make sure that your Last Bill is created as a Regular Bill !!!
                </div>
                <br/>
                <div class="d-inline-flex align-items-center alert alert-info" role="alert">
                    Bills will be created in draft so that you can review them before validation.
                </div>
                <group>
                    <field name="advance_payment_method" class="oe_inline"
                           widget="radio"/>
                    <field name="is_down_payments" invisible="1"/>
                    <label for="amount"
                           invisible="advance_payment_method not in ('fixed','percentage')"/>
                    <div invisible="advance_payment_method not in ('fixed','percentage')"
                         id="payment_method_details">
                        <field name="currency_id" invisible="1"/>
                        <field name="fixed_amount"
                               required="advance_payment_method == 'fixed'"
                               invisible="advance_payment_method != 'fixed'"
                               class="oe_inline"/>
                        <field name="amount"
                               required="advance_payment_method == 'percentage'"
                               invisible="advance_payment_method !=  'percentage'"
                               class="oe_inline"/>
                        <span
                                invisible="advance_payment_method != 'percentage'"
                                class="oe_inline">%
                        </span>
                    </div>
                    <field name="product_id"
                           context="{'default_invoice_policy': 'order'}"
                           class="oe_inline"
                           options="{'no_open':1, 'no_create':1}"
                           invisible="advance_payment_method not in ('fixed','percentage')"/>
                </group>
                <group>
                    <field name="po_amount"/>
                    <field name="amount_billed"/>
                    <field name="remaining_po_amount"/>
                </group>
                <footer>
                    <button name="action_create_advance_bill"
                            confirm="Are you sure?"
                            string="Create and View Bill" type="object"
                            context="{'open_invoices': True}"
                            class="btn-primary" data-hotkey="q"/>
                    <button name="action_create_advance_bill" id="create_advance_bill"
                            confirm="Are you sure?"
                            string="Create Bill" type="object"
                            data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action purchase.order.advance.payment -->
    <record id="action_purchase_order_advance_payment" model="ir.actions.act_window">
        <field name="name">Purchase Order Advance Payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order.advance.payment</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="target">new</field>
        <field name="binding_view_types">list</field>
        <field name="context">{"dialog_size": "extra-large"}</field>
    </record>

</odoo>
