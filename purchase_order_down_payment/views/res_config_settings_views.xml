<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View res.config.settings form -->
    <record id="purchase_order_down_payment.view_res_config_settings_form" model="ir.ui.view">
        <field name="name">purchase_order_down_payment.view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_settings_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Down Payment</span>
                        <div class="text-muted">
                            Product used for down payments in purchase bill
                        </div>
                        <div class="text-muted">
                            <field name="po_deposit_default_product_id"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

  </odoo>