<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bom_component_cost_sync.view_sale_order_bom_components_form_ext" model="ir.ui.view">
        <field name="name">view.sale.order.bom.component.form</field>
        <field name="model">sale.order.bom.component</field>
        <field name="inherit_id" ref="sale_custom_report.view_sale_order_bom_components_form_ext3"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_view_sale_order']"
                   position="after">
                <button name="sync_component_cost" string="Sync Component Cost" type="object"
                        class="btn oe_stat_button"/>
            </xpath>
            <xpath expr="//header"
                   position="inside">
                <button name="action_bulk_update_component_cost" string="Bulk Update Component Cost" type="object"
                        class="btn oe_stat_button"/>
            </xpath>

            <xpath expr="//field[@name='component_line_ids'][1]//list//field[@name='product_id']"
                   position="before">
                <field name="is_component_line_selected" optional="hide" class="text-center" width="120px" invisible="is_parent"/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][2]//list//field[@name='product_id']"
                   position="before">
                <field name="is_component_line_selected" optional="hide" class="text-center" width="120px" invisible="is_parent"/>
            </xpath>

            <xpath expr="//field[@name='component_line_ids'][3]//list//field[@name='product_id']"
                   position="before">
                <field name="is_component_line_selected" optional="hide" class="text-center" width="120px" invisible="is_parent "/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][4]//list//field[@name='product_id']"
                   position="before">
                <field name="is_component_line_selected" optional="hide" class="text-center" width="120px" invisible="is_parent"/>
            </xpath>
        </field>
    </record>
</odoo>