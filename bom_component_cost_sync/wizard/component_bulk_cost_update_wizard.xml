<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_bom_component_bulk_update_cost_wizard_form" model="ir.ui.view">
            <field name="name">bom.component.bulk.cost.update.wizard.form</field>
            <field name="model">bom.component.bulk.cost.update.wizard</field>
            <field name="arch" type="xml">
                <form string="Bulk Cost Update">
                    <sheet>
                        <group invisible="0">
                            <group>
                                <field name="new_manual_live_unit_cost"/>
                                <field name="component_id" readonly="1" invisible="1" force_save="1"/>
                                <field name="bom_component_lines_ids" invisible="1" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <field name="wizard_line_ids" widget="one2many" nolabel="1">
                            <list string="Components" editable="bottom" create="0">
                                <field name="parent_product_name" width="30%;" readonly="1"/>
                                <field name="product_id"
                                       options="{'no_create': True, 'no_open': True}"
                                       string="Product"
                                       required="1"
                                       readonly="1"
                                       force_save="1"
                                       width="30%;"/>
                                <field name="sale_order_bom_component_line_id" force_save="1" column_invisible="1"/>

                                <field name="manual_live_unit_cost"
                                       required="1"
                                       readonly="1"
                                       force_save="1"
                                       class="text-end"
                                       width="10%;"/>
                            </list>
                        </field>
                    </sheet>

                    <footer>
                        <button name="action_apply_new_cost" string="Apply" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_bom_component_bulk_update_cost_wizard" model="ir.actions.act_window">
            <field name="name">Bulk Cost Update</field>
            <field name="res_model">bom.component.bulk.cost.update.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_bom_component_bulk_update_cost_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>