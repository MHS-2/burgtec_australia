<odoo>
    <data>
        <!-- Sales Order list view definition -->

        <record model="ir.ui.view" id="burgtec_list_views.sales_order_list">
            <field name="name">burgtec.list.views.sales.order.list</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">

                <xpath expr="//list" position="replace">
                    <list class="o_sale_order" string="Sales Orders" sample="1" decoration-muted="state == 'cancel'">
                        <field name="message_needaction" column_invisible="True"/>
                        <field name="currency_id" column_invisible="True"/>
                        <button type="object" name="open_record_in_new_window" class="btn btn-link"
                                icon="fa-external-link" title="Open Sale Order in New Tab"/>
                        <field name="burgtec_quote_reference" readonly="1" decoration-bf="1" width="600px"/>
                        <field name="project_name" width="500px"/>
                        <field name="quote_type" widget="badge" width="500px"
                               decoration-success="quote_type == 'delivery_stage'"
                               decoration-info="quote_type == 'sales_quote'"
                               decoration-warning="quote_type == 'project_quote'"/>
                        <field name="system_revision" width="150px" string="Revision" optional="show"/>
                        <field name="zone_type" width="150px"/>
                        <field name="date_order" width="370px" optional="show" readonly="state in ['cancel', 'sale']"/>
                        <field name="commitment_date" optional="hide"/>
                        <field name="expected_date" optional="hide"/>
                        <field name="partner_id" readonly="1" width="170px"/>
                        <field name="user_id" widget="many2one_avatar_user" optional="show" width="520px"/>
                        <!-- <field name="activity_ids" widget="list_activity" optional="show"/> -->
                        <!-- <field name="team_id" optional="hide"/> -->
                        <field name="company_id" groups="!base.group_multi_company" column_invisible="True"/>
                        <field name="company_id" width="230px"
                               groups="base.group_multi_company"
                               optional="show"
                               readonly="1"/>
                        <field name="pricelist_id" width="180px" optional="show"/>
                        <field name="payment_term_id" width="220px" optional="show"/>
                        <field name="amount_untaxed" width="600px"
                               sum="Total Tax Excluded"
                               widget="monetary"
                               optional="show"/>
                        <field name="amount_tax" width="220px"
                               sum="Tax Total"
                               widget="monetary"
                               optional="show"/>
                        <field name="amount_total" width="220px"
                               sum="Total Tax Included"
                               widget="monetary"
                               decoration-bf="1"
                               decoration-info="invoice_status == 'to invoice'"
                               optional="show"/>
                        <!-- <field name="tag_ids"
                              widget="many2many_tags"
                              options="{'color_field': 'color'}"
                              optional="hide"/> -->
                        <field name="state" width="180px"
                               decoration-success="state == 'sale'"
                               decoration-info="state == 'draft'"
                               decoration-primary="state == 'sent'"
                               widget="badge"
                               optional="hide"/>
                        <field name="invoice_status" width="180px"
                               decoration-success="invoice_status == 'invoiced'"
                               decoration-info="invoice_status == 'to invoice'"
                               decoration-warning="invoice_status == 'upselling'"
                               widget="badge"
                               optional="hide"
                               invisible="quote_type != 'project_quote'"/>
                        <field name="client_order_ref" optional="hide" width="180px"/>
                        <field name="validity_date" optional="hide" width="180px"/>
                        <field name="name" string="Number" readonly="1" decoration-bf="1" optional="hide"
                               width="180px"/>
                        <field name="since_earliest_po_weekly_update" class="text-center" optional="hide" width="180px"
                               invisible="quote_type != 'delivery_stage'"/>
                        <field name="hubspot_ticket_id" class="text-center" invisible="quote_type != 'delivery_stage'"
                               readonly="1" optional="hide" width="300px"/>
                        <field name="hubspot_ticket_schedule_dispatch" invisible="quote_type != 'delivery_stage'"
                               readonly="1" width="200px" optional="hide"/>
                        <field name="latest_eta_date" invisible="quote_type != 'delivery_stage'" width="170px"
                               optional="hide"/>
                        <field name="scheduled_delivers_date" string="Scheduled Delivery" optional="hide" width="170px"
                               invisible="quote_type != 'delivery_stage'" readonly="1"/>
                        <field name="scheduled_install_date" string="Scheduled Install" optional="hide" width="170px"
                               invisible="quote_type != 'delivery_stage'" readonly="1"/>
                        <field name="scheduled_install_complete_date" string="Scheduled Install Complete"
                               optional="hide" width="170px"
                               invisible="quote_type != 'delivery_stage'" readonly="1"/>
                        <field string="ETA vs Dispatch (Days)" name="latest_eta_dispatch_date_diff"
                               invisible="quote_type != 'delivery_stage'" width="200px" optional="hide"
                               class="text-center"/>
                        <field name="delay_risk" invisible="not delay_risk or quote_type != 'delivery_stage'"
                               width="170px" optional="hide"/>
                        <field name="hubspot_ticket_status" width="350px" optional="hide"/>
                        <field name="delivery_status_tracking" string="Delivery Status"
                               decoration-muted="delivery_status_tracking == 'unscheduled'"
                               decoration-info="delivery_status_tracking == 'fully_received'"
                               decoration-success="delivery_status_tracking == 'on_track'"
                               decoration-warning="delivery_status_tracking == 'caution'"
                               decoration-danger="delivery_status_tracking == 'off_track'"
                               widget="badge" invisible="quote_type != 'delivery_stage'" width="350px" optional="hide"/>
                        <field name="is_backorder_registered" optional="hide" width="200px" widget="boolean_toggle"
                               invisible="quote_type != 'delivery_stage'" readonly="1"/>
                        <field name="qr_url" widget="url" readonly="1" width="150px" optional="hide"
                               invisible="quote_type != 'delivery_stage'" string="Hubspot Ticket URL"/>

                    </list>
                </xpath>

            </field>
        </record>

