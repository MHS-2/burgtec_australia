        <record id="burgtec_list_views.sale_order_tree" model="ir.ui.view">
            <field name="name">burgtec_list_views.sale.order.list.inherit.website.sale</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='website_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>

            </field>
        </record>

        <!-- Purchase Orders List Views -->


        <record id="burgtec_list_views.purchase_order_kpis_tree_inherit" model="ir.ui.view">
            <field name="name">burgtec_list_views.purchase.order.kpis.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="replace">
                    <list string="Purchase Order" decoration-info="state in ['draft', 'sent']"
                          decoration-muted="state == 'cancel'" class="o_purchase_order"
                          js_class="purchase_dashboard_list" sample="1">
                        <!-- <header>
                            <button name="action_create_invoice" type="object" string="Create Bills"/>
                            <button name="button_cancel" type="object" string="Cancel"
                                confirm="Are you sure you want to cancel the selected RFQs/Orders?"/>
                        </header> -->
                        <button type="object" name="open_record_in_new_window" class="btn btn-link"
                                icon="fa-external-link" title="Open Purchase Order in New Tab"/>
                        <field name="priority" optional="hide" widget="priority" nolabel="1" width="25px"/>
                        <field name="burgtec_purchase_reference" readonly="1" decoration-bf="1" width="600px"/>
                        <field name="partner_id" readonly="1" width="300px"/>
                        <field name="partner_ref" optional="hide" width="500px"/>
                        <field name="burgtec_po_status" widget="badge" width="200px"
                               decoration-warning="burgtec_po_status in ['sent','await_receipt']"
                               decoration-info="burgtec_po_status in ['draft_to_approve','draft_to_sent']"
                               decoration-primary="burgtec_po_status in ['received_partial','received_full']"
                               decoration-success="burgtec_po_status in ['delivery_only','delivered_partial','delivered_full']"/>
                        <field name="required_arrival_date" width="200px"/>
                        <field name="hubspot_dispatch_date" width="200px"/>
                        <field name="date_planned" width="200px"/>
                        <field name="bo_number" string="BO Number#" width="250px" optional="show"/>
                        <field name="is_po_not_going_to_bv" readonly="1" widget="boolean_toggle" width="250px"
                               optional="hide"/>
                        <field name="bo_notes" width="250px" optional="hide"/>
                        <field name="is_burgtec_vendor" widget="boolean_toggle" width="500px" optional="hide"/>
                        <field name="deal_project_name" width="300px"/>
                        <field name="tag" readonly="1" widget="badge" decoration-success="tag == 'child'"
                               decoration-primary="tag == 'parent'" width="500px"/>
                        <!-- <field name="name" string="Reference" readonly="1" decoration-bf="1"/> -->
                        <field name="date_approve" column_invisible="context.get('quotation_only', False)"
                               optional="show"/>
                        <field name="company_id" readonly="1" options="{'no_create': True}"
                               groups="base.group_multi_company" optional="show"/>
                        <field name="company_id" groups="!base.group_multi_company" column_invisible="True"
                               readonly="state in ['cancel', 'done', 'purchase']"/>
                        <field name="is_manual_expected_arrival" widget="boolean_toggle" readonly="1" width="200px"/>
                        <field name="last_po_weekly_update_date" optional="show" width="200px"/>
                        <field name="overdue_po_weekly_update" widget="boolean_toggle" readonly="1" optional="show"
                               width="200px"/>
                        <field name="po_due_in_two_days" widget="boolean_toggle" readonly="1" optional="show"
                               width="200px"/>
                        <field name="po_due_after_dispatch" widget="boolean_toggle" readonly="1" optional="show"
                               width="200px"/>
                        <field name="po_sent_date" string="PO Sent Date" readonly="1" optional="show" width="200px"/>
                        <field name="since_sent_days" string="Since Sent Days" readonly="1" optional="show"
                               width="200px"/>
                        <field name="user_id" optional="show" widget="many2one_avatar_user" width="200px"/>
                        <field name="date_order" width="150px"
                               invisible="state == 'purchase' or state == 'done' or state == 'cancel'"
                               column_invisible="not context.get('quotation_only', False)"
                               readonly="state in ['cancel', 'done', 'purchase']" widget="remaining_days"
                               optional="show"/>
                        <!-- <field name="activity_ids" widget="list_activity" optional="show"/> -->
                        <field name="origin" optional="show" width="150px"/>
                        <field name="picking_type_id" optional="show" width="200px"/>
                        <field name="dest_address_id" optional="show" width="230px"/>
                        <field name="shipping_address_type" optional="show" width="260px"/>
                        <field name="manual_shipping_address" optional="show" width="300px"
                               invisible="shipping_address_type not in 'manual'"/>
                        <field name="wh_rack_location" readonly="1" widget="url" optional="hide" width="250px"/>
                        <field name="delivery_stage_link" optional="hide" readonly="1" widget="url" width="250px"/>
                        <field name="onedrive_po_folder_link" optional="hide" readonly="1" widget="url" width="250px"/>
                        <field name="amount_untaxed" sum="Total Untaxed amount" string="Untaxed" widget="monetary"
                               optional="show" width="250px"/>
                        <field name="amount_total" sum="Total amount" widget="monetary" optional="show"
                               decoration-bf="state in ['purchase', 'done']" width="250px"/>
                        <field name="currency_id" column_invisible="True"
                               readonly="state in ['cancel', 'done', 'purchase']"/>
                        <field name="remaining_purchase_amount" width="250px" widget="monetary" sum="Outstanding Balance"/>
                        <field name="amount_total_cc" sum="Total amount" widget="monetary" optional="hide"
                               width="250px"/>
                        <field name="company_currency_id" column_invisible="True"/>
                        <field name="state" optional="show" widget="badge"
                               decoration-success="state == 'purchase' or state == 'done'"
                               decoration-warning="state == 'to approve'"
                               decoration-info="state == 'draft' or state == 'sent'" width="250px"/>
                        <field name="invoice_status" optional="show" width="180px"/>
                        <field name="purchase_comments" width="200px" optional="show"/>

                    </list>
                </xpath>
            </field>
        </record>

