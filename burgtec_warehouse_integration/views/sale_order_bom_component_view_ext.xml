<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_new_decoration_sale_order_bom_components_form_ext" model="ir.ui.view">
        <field name="name">burgtec_warehouse_integration.view.new.decoration.sale.order.bom.components.form.ext</field>
        <field name="model">sale.order.bom.component</field>
        <field name="inherit_id" ref="artwork_url_attachment_for_screens.view_sale_order_bom_components_form_ext"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='component_line_ids'][1]/list" position="inside">
                <field name="is_present_in_warehouse" string="Component Available in WH Instance?" class="text-center"
                       column_invisible="1"/>
                <field name="is_delivery_and_installation" string="Delivery Install?" class="text-center"
                       column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][1]/list//field[@name='product_id']" position="before">
                <field name="warehouse_status_html" widget="html" string="In Wh?" class="text-start" width="40px"
                       invisible="is_present_in_warehouse or is_delivery_and_installation or is_parent"/>
                <field name="warehouse_bom_id"
                       invisible="is_parent or is_delivery_and_installation or not is_present_in_warehouse"
                       options="{'no_create': True}" domain="[('product_id','=', product_id)]"/>

            </xpath>

            <xpath expr="//field[@name='component_line_ids'][2]/list" position="inside">
                <field name="is_present_in_warehouse" string="Component Available in WH Instance?" class="text-center"
                       column_invisible="1"/>
                <field name="is_delivery_and_installation" string="Delivery Install?" class="text-center"
                       column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][2]/list//field[@name='product_id']" position="before">
                <field name="warehouse_status_html" widget="html" string="In Wh?" class="text-start" width="40px"
                       invisible="is_present_in_warehouse or is_delivery_and_installation or is_parent"/>
                <field name="warehouse_bom_id"
                       invisible="is_parent or is_delivery_and_installation or not is_present_in_warehouse"
                       options="{'no_create': True}" domain="[('product_id','=', product_id)]"/>


            </xpath>

            <xpath expr="//field[@name='component_line_ids'][3]/list" position="inside">
                <field name="is_present_in_warehouse" string="Component Available in WH Instance?" class="text-center"
                       column_invisible="1"/>
                <field name="is_delivery_and_installation" string="Delivery Install?" class="text-center"
                       column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][3]/list//field[@name='product_id']" position="before">
                <field name="warehouse_status_html" widget="html" string="In Wh?" class="text-start" width="40px"
                       invisible="is_present_in_warehouse or is_delivery_and_installation or is_parent"/>
                <field name="warehouse_bom_id"
                       invisible="is_parent or is_delivery_and_installation or not is_present_in_warehouse"
                       options="{'no_create': True}" domain="[('product_id','=', product_id)]"/>


            </xpath>
            <xpath expr="//field[@name='component_line_ids'][4]/list" position="inside">
                <field name="is_present_in_warehouse" string="Component Available in WH Instance?" class="text-center"
                       column_invisible="1"/>
                <field name="is_delivery_and_installation" string="Delivery Install?" class="text-center"
                       column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='component_line_ids'][4]/list//field[@name='product_id']" position="before">
                <field name="warehouse_status_html" widget="html" string="In Wh?" class="text-start" width="40px"
                       invisible="is_present_in_warehouse or is_delivery_and_installation or is_parent"/>
                <field name="warehouse_bom_id"
                       invisible="is_parent or is_delivery_and_installation or not is_present_in_warehouse"
                       options="{'no_create': True}" domain="[('product_id','=', product_id)]"/>

            </xpath>

            <xpath expr="//field[@name='vendor_component_line_ids']/list//field[@name='supplier_id']" position="before">
                <field name="warehouse_bom_id"/>
            </xpath>


        </field>
    </record>
</odoo>