<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_burgtec_warehouse_credentials" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.burgtec.warehouse.credentials</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="connectors_setting_container" position="after">
                <block title="Burgtec Warehouse Instance (Odoo 19)" id="burgtec_warehouse_setting_container">
                    <setting string="Connection" help="JSON-2 API of the Warehouse instance">

                        <div class="row mt-2">
                            <div class="col-4">
                                <label for="burgtec_warehouse_url"/>
                            </div>
                            <div class="col-8">
                                <field name="burgtec_warehouse_url" placeholder="https://warehouse.burgtec.com"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-4">
                                <label for="burgtec_warehouse_db"/>
                            </div>
                            <div class="col-8">
                                <field name="burgtec_warehouse_db"/>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-4">
                                <label for="burgtec_warehouse_api_key"/>
                            </div>
                            <div class="col-8">
                                <field name="burgtec_warehouse_api_key" password="True"/>
                            </div>
                        </div>
                    </setting>
                </block>
                <block title="Webhook Authentication Token" id="burgtec_warehouse_setting_container">
                    <setting string="Authentication Token for Webhook calls"
                             help="Shared secret that authenticates calls from the Warehouse (Odoo 19) instance. Must match the token set in Odoo 19.">
                        <div class="row mt-2">
                            <div class="col-4">
                                <label for="burgtec_webhook_authentication_token"/>
                            </div>
                            <div class="col-8">
                                <field name="burgtec_webhook_authentication_token"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
