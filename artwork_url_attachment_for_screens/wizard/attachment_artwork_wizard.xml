<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_attachment_artwork_wizard_form" model="ir.ui.view">
            <field name="name">attachment.artwork.wizard.form</field>
            <field name="model">attachment.artwork.wizard</field>
            <field name="arch" type="xml">
                <form string="Add Artwork">
                    <sheet>
                        <group>
                            <group>
                                <field name="component_id" readonly="1" invisible="1"/>
                                <field name="bom_line_id" readonly="1" invisible="1"/>
                                <field name="planning_screen_line_id" readonly="1" invisible="1"/>
                                <field name="sale_quote_planning_screen_line_id" readonly="1" invisible="1"/>
                                <!--                                <field name="art_work_image" widget="image"/>-->
                                <field name="preview_image"
                                       widget="image"
                                       readonly="1"
                                       invisible="not preview_image"/>
                                <field name="attachment_file" filename="attachment_filename"/>
                                <field name="attachment_filename" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_add_url" string="Add Artwork" type="object" confirm="If a previous attachment exists, it will be deleted. Do you want to continue?"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_attachment_artwork_wizard" model="ir.actions.act_window">
            <field name="name">Add Artwork</field>
            <field name="res_model">attachment.artwork.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="artwork_url_attachment_for_screens.view_attachment_artwork_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>