                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='sale_order_option_ids']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='down_payment_order_line_ids']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
