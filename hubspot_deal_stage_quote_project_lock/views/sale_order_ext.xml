    <!-- FORM VIEW  -->
    <record id="view_sale_order_line_from_planning_screen" model="ir.ui.view">
        <field name="name">view.sale.order.line.from.planning.screen</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="View Sale Order Product Line">
                <sheet>
                    <group>
                        <group>
                            <field name="custom_product_name" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="image_128" widget="image"
                                   options="{'size': [200, 200]}" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer></footer>
            </form>
        </field>
    </record>
</odoo>