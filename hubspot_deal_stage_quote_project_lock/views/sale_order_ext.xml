            <xpath expr="//field[@name='date_order']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='validity_date']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='zone_type']"
                   position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
