            <xpath expr="//field[@name='delivery_code_calculation_line_ids']" position="attributes">
                <attribute name="readonly" add="freeze_sale_order and quote_type == 'project_quote'" separator=" or "/>
            </xpath>

        </field>
    </record>
</odoo>