<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hubspot_deal_stage_quote_project_lock.delivery_code_calculation_view_ext_1" model="ir.ui.view">
        <field name="name">hubspot deal stage quote/project lock planning screen view ext</field>
        <field name="model">delivery.code.calculation</field>
        <field name="inherit_id" ref="quotation_type_customization.delivery_code_calculation_view_ext"/>
