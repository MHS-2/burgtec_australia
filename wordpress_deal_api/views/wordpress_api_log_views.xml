<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wordpress_api_log_view_list" model="ir.ui.view">
        <field name="name">wordpress.api.log.list</field>
        <field name="model">wordpress.api.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="id desc">
                <field name="create_date"/>
                <field name="key_name"/>
                <field name="method"/>
                <field name="endpoint"/>
                <field name="deal_id"/>
                <field name="status"/>
                <field name="external_ref" optional="hide"/>
                <field name="ip_address" optional="show"/>
                <field name="detail" optional="show"/>
            </list>
        </field>
    </record>

    <record id="wordpress_api_log_view_search" model="ir.ui.view">
        <field name="name">wordpress.api.log.search</field>
        <field name="model">wordpress.api.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="endpoint"/>
                <field name="key_name"/>
                <field name="deal_id"/>
                <field name="external_ref"/>
                <field name="ip_address"/>
                <filter string="Errors" name="errors" domain="[('status', '&gt;=', 400)]"/>
                <filter string="Success" name="success" domain="[('status', '&lt;', 400)]"/>
                <group expand="0" string="Group By">
                    <filter string="Endpoint" name="group_endpoint" context="{'group_by': 'endpoint'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Key" name="group_key" context="{'group_by': 'key_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="wordpress_api_log_action" model="ir.actions.act_window">
        <field name="name">WordPress API Log</field>
        <field name="res_model">wordpress.api.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="wordpress_api_log_menu"
              name="WordPress API Log"
              parent="base.menu_custom"
              action="wordpress_api_log_action"
              groups="base.group_system"
              sequence="90"/>
</odoo>
