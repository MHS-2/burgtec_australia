<odoo>
    <!-- Website Product Category Tree -->
    <record id="view_website_product_category_list" model="ir.ui.view">
        <field name="name">website.product.category.list</field>
        <field name="model">website.product.category</field>
        <field name="arch" type="xml">
            <list string="Website Product Categories">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Website Product Category Form -->
    <record id="view_website_product_category_form" model="ir.ui.view">
        <field name="name">website.product.category.form</field>
        <field name="model">website.product.category</field>
        <field name="arch" type="xml">
            <form string="Website Product Category">
                <sheet>
                    <group>
                        <div class="oe_title">
                            <label for="name" string="Category"/>
                            <h1>
                                <field name="name" placeholder="e.g. Lamps"/>
                            </h1>
                        </div>
                        <field name="parent_id"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_website_product_category" model="ir.actions.act_window">
        <field name="name">Website Product Categories</field>
        <field name="res_model">website.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_website_product_category_root"
              name="Website Product Categories"
              action="action_website_product_category"
              parent="stock.menu_product_in_config_stock"
              sequence="1"/>
</odoo>
