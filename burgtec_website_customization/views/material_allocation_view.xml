<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="material_allocation_view_list" model="ir.ui.view">
        <field name="name">material.allocation.view.list</field>
        <field name="model">material.allocation</field>     
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="material_allocation_view_form" model="ir.ui.view">
        <field name="name">material.allocation.view.form</field>
        <field name="model">material.allocation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="material_allocation_action" model="ir.actions.act_window">
        <field name="name">Material Allocation</field>
        <field name="res_model">material.allocation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="material_allocation_menu"
        name="Material Allocation"
        action="material_allocation_action"
        parent="stock.menu_product_in_config_stock"
        sequence="8"/>

    <menuitem
        id="material_allocation_sale_menu"
        name="Material Allocation"
        action="material_allocation_action"
        parent="sale.prod_config_main"
        sequence="14"/>

    <menuitem
        id="material_allocation_purchase_menu"
        name="Material Allocation"
        action="material_allocation_action"
        parent="purchase.menu_product_in_config_purchase"
        sequence="5"/>

</odoo>
