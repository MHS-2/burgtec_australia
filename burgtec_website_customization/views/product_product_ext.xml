<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_variant_form_inherit_burgtec_variant" model="ir.ui.view">
        <field name="name">product.variant.form.inherit.burgtec.variant</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='sales']/group[@name='sale']" position="before">
                <group name="optional_groups" string="Optional Groups">
                    <field name="optional_group_ids" widget="one2many">
                        <list editable="bottom">
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="optional_group_id" options="{'no_create':1,'no_open':1}"/>
                        </list>
                    </field>
                </group>
            </xpath>

            <xpath expr="//field[@name='optional_product_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='inventory']" position="after">
                <page string="Website Info" name="burgtec_variant_info">
                    <group>
                        <field name="api_variant_website_name"/>
                        <field name="api_variant_list_price"/>
                        <field name="is_product_published" string="Is Published"/>
                        <field name="is_modular_variant_product"/>
                        <field name="is_purchasable_online_variant"/>
                        <field name="api_variant_unit" string="Unit"/>
                        <field name="is_preconfigured"/>
                        <field name="api_variant_delivery_code_selection_id"/>
                        <separator string="Featured Attachments" colspan="2"/>
                        <field name="api_variant_featured_attachment_ids" widget="image_carousel"
                               options="{'no_create': True}"/>
                        <separator string="3D Configurator Attachments" colspan="2"/>
                        <field name="api_variant_three_d_attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group name='preconfigured_attribute_lines' string='Preconfugred Attribute Lines'>
                        <field name='preconfigured_attribute_line_ids' widget="one2many" nolabel="1">
                            <list editable="bottom" create="0" delete="0">
                                <field name="sub_attribute_line_id" column_invisible="1" force_save="1"/>
                                <field name="product_template_attribute_value_id" readonly="1" force_save="1"
                                       options="{'no_open':1}"/>
                                <!-- <field name="material_allocation" readonly="1" force_save="1"/> -->
                                <field name="material_allocation_id" readonly="1" force_save="1"
                                       options="{'no_open':1}"/>
                                <field name="sub_attribute_id" readonly="1" force_save="1" options="{'no_open':1}"/>
                                <field name="sub_attribute_value_ids" widget="many2many_tags"
                                       domain="[('sub_attribute_id','=', sub_attribute_id)]"/>
                            </list>
                        </field>
                    </group>
                    <group name="preconfigured_attribute_option" string="Preconfigured Attribute Option">
                        <button name="create_preconfigured_options" type="object" string="Create Option"
                                class="btn-link" confirm="Are you sure?" icon="fa-plus"/>
                        <button name="open_preconfigured_options" type="object" string="Open Options" class="btn-link"
                                invisible="not preconfigured_attribute_option_ids" icon="fa-external-link"/>
                        <field name="preconfigured_attribute_option_ids" widget="many2many_tags" readonly="1"
                               force_save="1" nolabel="1"/>
                    </group>
                    <group string="Dimensions">
                        <group>
                            <field name="api_variant_height" placeholder="Add Height Here."/>
                            <field name="api_variant_depth" placeholder="Add Depth Here."/>
                            <field name="api_variant_worktop_width" placeholder="Add Worktop Width Here."/>
                            <field name="api_variant_seat_depth" placeholder="Add Seat Depth Here."/>
                        </group>
                        <group>
                            <field name="api_variant_width" placeholder="Add Width Here."/>
                            <field name="api_variant_worktop_height" placeholder="Add Worktop Height Here."/>
                            <field name="api_variant_seat_height" placeholder="Add Seat Height Here."/>
                            <field name="api_variant_seat_width" placeholder="Add Seat Width Here."/>
                        </group>
                    </group>
                </page>
            </xpath>


        </field>
    </record>
    <record id="view_product_variant_easy_edit_form_inherit_burgtec" model="ir.ui.view">
        <field name="name">product.variant.easy.edit.form.inherit.burgtec</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet//group[@name='sales']" position="after">
                <separator string="Website Information" colspan="2"/>
                <group>
                    <field name="api_variant_website_name"/>
                    <field name="api_variant_list_price"/>
                    <label for="is_product_published" string="Is Published"/>
                    <field name="is_product_published" nolabel="1"/>
                    <field name="is_modular_variant_product"/>
                    <field name="is_purchasable_online_variant"/>
                    <field name="api_variant_unit" string="Unit"/>
                    <field name="is_preconfigured"/>
                    <field name="api_variant_delivery_code_selection_id"/>
                    <separator string="Featured Attachments" colspan="2"/>
                    <field name="api_variant_featured_attachment_ids" widget="image_carousel"
                           options="{'no_create': True}"/>
                    <separator string="3D Configurator Attachments" colspan="2"/>
                    <field name="api_variant_three_d_attachment_ids" widget="many2many_binary"
                           options="{'no_create': True}"/>
                </group>
                <group></group>
                <group colspan="2" name='preconfigured_attribute_lines' string='Preconfugred Attribute Lines'>
                    <field name='preconfigured_attribute_line_ids' widget="one2many" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sub_attribute_line_id" column_invisible="1" force_save="1"/>
                            <field name="product_template_attribute_value_id" readonly="1" force_save="1"
                                   options="{'no_open':1}"/>
                            <!-- <field name="material_allocation" readonly="1" force_save="1"/> -->
                            <field name="material_allocation_id" readonly="1" force_save="1" options="{'no_open':1}"/>
                            <field name="sub_attribute_id" readonly="1" force_save="1" options="{'no_open':1}"/>
                            <field name="sub_attribute_value_ids" widget="many2many_tags"
                                   domain="[('sub_attribute_id','=', sub_attribute_id)]"/>
                        </list>
                    </field>
                </group>
                <group name="preconfigured_attribute_option" string="Preconfigured Attribute Option">
                    <button name="create_preconfigured_options" type="object" string="Create Option" class="btn-link"
                            confirm="Are you sure?" icon="fa-plus"/>
                    <button name="open_preconfigured_options" type="object" string="Open Options" class="btn-link"
                            invisible="not preconfigured_attribute_option_ids" icon="fa-external-link"/>
                    <field name="preconfigured_attribute_option_ids" widget="many2many_tags" placeholder="Options"
                           readonly="1" force_save="1" nolabel="1"/>
                </group>
                <group></group>
                <group name="optional_groups" string="Optional Groups">
                    <field name="optional_group_ids" widget="one2many" nolabel="1">
                        <list editable="bottom">
                            <field name="name" readonly="1" force_save="1"/>
                            <field name="optional_group_id" options="{'no_create':1,'no_open':1}"/>
                        </list>
                    </field>
                </group>

                <group string="Dimensions">
                    <group>
                        <field name="api_variant_height" placeholder="Add Height Here."/>
                        <field name="api_variant_depth" placeholder="Add Depth Here."/>
                        <field name="api_variant_worktop_width" placeholder="Add Worktop Width Here."/>
                        <field name="api_variant_seat_depth" placeholder="Add Seat Depth Here."/>
                    </group>
                    <group>
                        <field name="api_variant_width" placeholder="Add Width Here."/>
                        <field name="api_variant_worktop_height" placeholder="Add Worktop Height Here."/>
                        <field name="api_variant_seat_height" placeholder="Add Seat Height Here."/>
                        <field name="api_variant_seat_width" placeholder="Add Seat Width Here."/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//form//group[@name='weight']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_product_product_list_inherit_burgtec" model="ir.ui.view">
        <field name="name">product.product.list.inherit.burgtec</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_template_variant_value_ids']" position="after">
                <field name="is_product_published" string="Is Published" width="100px"/>
                <field name="is_preconfigured" string="Is Preconfigured Frontend" width="200px"/>
                <field name="is_modular_variant_product" width="150px"/>
                <field name="is_purchasable_online_variant" width="160px"/>

            </xpath>
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="image_1920" widget="image" class="oe_avatar"/>
            </xpath>

        </field>
    </record>
</odoo>
