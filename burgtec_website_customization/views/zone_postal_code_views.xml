<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View zone.postal.code View List -->
    <record id="view_zone_postal_code_list" model="ir.ui.view">
        <field name="name">view.zone.postal.code.list</field>
        <field name="model">zone.postal.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Postal Code"/>
            </list>
        </field>
    </record>

    <!-- View zone.postal.code form -->
    <record id="view_zone_postal_code_form" model="ir.ui.view">
        <field name="name">view.zone.postal.code.form</field>
        <field name="model">zone.postal.code</field>
        <field name="arch" type="xml">
            <form string="Postal Code">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Postal Code"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View zone.postal.code search -->
    <record id="view_zone_postal_code_search" model="ir.ui.view">
        <field name="name">view.zone.postal.code.search</field>
        <field name="model">zone.postal.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Postal Code"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action zone.postal.code -->
    <record id="action_zone_postal_code" model="ir.actions.act_window">
        <field name="name">Postal Code</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">zone.postal.code</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Zone Postal Code.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zone_postal_codes_sale"
        name="Postal Codes"
        action="action_zone_postal_code"
        parent="sale.prod_config_main"
        sequence="102"/>
    
    <menuitem id="menu_zone_postal_codes_product"
              name="Postal Codes"
              action="action_zone_postal_code"
              parent="stock.menu_product_in_config_stock"
              sequence="1000"/>

</odoo>
