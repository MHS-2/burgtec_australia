<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sub_attribute_view_list" model="ir.ui.view">
        <field name="name">sub_attribute.view.list</field>
        <field name="model">sub.attribute</field>     
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="display_type"/>
                <field name="sub_attribute_type_id"/>
            </list>
        </field>
    </record>

    <record id="sub_attribute_view_form" model="ir.ui.view">
        <field name="name">sub_attribute.view.form</field>
        <field name="model">sub.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Sub Attribute Name"/>
                        <field name="display_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="sub_attribute_type_id" options="{'no_open':1, 'no_create':1}"/>
                    </group>
                    <notebook>
                        <page name="sub_attribute_value_lines" string="Sub Attribute Values">
                            <field name="sub_attribute_value_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="html_color"
                                       widget="color"
                                       column_invisible="parent.display_type != 'color'"
                                    />
                                    <!-- invisible="image" -->
                                    <field name="image"
                                        widget="image"
                                        options="{'size': [70, 70]}"
                                        class="oe_avatar text-start float-none"
                                        column_invisible="parent.display_type != 'color'"/>
                                    <field name="texture_image"
                                        widget="image"/>
                                    <field name="lead_time" placeholder="Lead Time"/>
                                    <field name="is_default_website" string="Default For Website"/>
                                    <field name="metalness"/>
                                    <field name="roughness"/>
                                    <field name="default_extra_price"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sub_attribute_action" model="ir.actions.act_window">
        <field name="name">Sub Attributes</field>
        <field name="res_model">sub.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="sub_attribute_menu"
        name="Sub Attributes"
        action="sub_attribute_action"
        parent="stock.menu_product_in_config_stock"
        sequence="5"/>

    <menuitem
        id="sub_attribute_sale_menu"
        name="Sub Attributes"
        action="sub_attribute_action"
        parent="sale.prod_config_main"
        sequence="11"/>

    <menuitem
        id="sub_attribute_purchase_menu"
        name="Sub Attributes"
        action="sub_attribute_action"
        parent="purchase.menu_product_in_config_purchase"
        sequence="2"/>

</odoo>
