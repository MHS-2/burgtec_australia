<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sub_attribute_type_view_list" model="ir.ui.view">
        <field name="name">sub_attribute.type.view.list</field>
        <field name="model">sub.attribute.type</field>     
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="sub_attribute_type_view_form" model="ir.ui.view">
        <field name="name">sub_attribute.type.view.form</field>
        <field name="model">sub.attribute.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Sub Attribute Name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sub_attribute_type_action" model="ir.actions.act_window">
        <field name="name">Sub Attribute Type</field>
        <field name="res_model">sub.attribute.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="sub_attribute_type_menu"
        name="Sub Attribute Type"
        action="sub_attribute_type_action"
        parent="stock.menu_product_in_config_stock"
        sequence="6"/>

    <menuitem
        id="sub_attribute_type_sale_menu"
        name="Sub Attribute Type"
        action="sub_attribute_type_action"
        parent="sale.prod_config_main"
        sequence="12"/>

    <menuitem
        id="sub_attribute_type_purchase_menu"
        name="Sub Attribute Type"
        action="sub_attribute_type_action"
        parent="purchase.menu_product_in_config_purchase"
        sequence="3"/>

</odoo>
