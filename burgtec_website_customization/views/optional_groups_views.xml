<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="optional_groups_list_view" model="ir.ui.view">
        <field name="name">optional.groups.list.view</field>
        <field name="model">optional.groups</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="website_name"/>
                <field name="is_publish"/>
            </list>
        </field>
    </record>

    <record id="optional_groups_form_view" model="ir.ui.view">
        <field name="name">optional.groups.form.view</field>
        <field name="model">optional.groups</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="website_name"/>
                        <field name="is_publish" widget="boolean_toggle"/>
                    </group>
                    <notebook>
                        <page name="product_items" string="Product Items">
                            <field name="product_ids" placeholder="Select Products Here" domain="[('product_bom_type', '!=', 'components')]" options="{'no_create':1}" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_optional_groups" model="ir.actions.act_window">
        <field name="name">Optional Groups</field>
        <field name="res_model">optional.groups</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_optional_groups"
        name="Optional Groups"
        action="action_optional_groups"
        parent="stock.menu_product_in_config_stock"
        sequence="7"/>
    
    <menuitem
        id="optional_groups_sale_menu"
        name="Optional Groups"
        action="action_optional_groups"
        parent="sale.prod_config_main"
        sequence="13"/>

    <menuitem
        id="optional_groups_purchase_menu"
        name="Optional Groups"
        action="action_optional_groups"
        parent="purchase.menu_product_in_config_purchase"
        sequence="4"/>
</odoo>