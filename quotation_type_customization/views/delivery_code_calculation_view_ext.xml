<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="quotation_type_customization.delivery_code_calculation_view_ext" model="ir.ui.view">
            <field name="name">quote.type.new.delivery.stage.sale.order.view.ext</field>
            <field name="model">delivery.code.calculation</field>
            <field name="inherit_id" ref="sale_custom_report.delivery_code_calculation_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='delivery_code_calculation_line_ids']"
                       position="attributes">
                    <attribute name="readonly">order_id.quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='manual_percentage']"
                       position="attributes">
                    <attribute name="readonly">order_id.quote_type == 'delivery_stage'</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>