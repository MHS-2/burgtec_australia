<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quotation_type_customization.sale_order_ext" model="ir.ui.view">
            <field name="name">sale.order.form.series_sequence</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">


                <xpath expr="//header" position="inside">
                    <button
                            name="action_project_wise_delivery_report"
                            type="object"
                            string="Breakdown Report"
                            class="btn btn-primary"
                            invisible="quote_type != 'project_quote' or child_quote_count == 0">
                    </button>
                </xpath>

                <xpath expr="//field[@name='hubspot_reference']" position="replace">
                    <div class="o_row" invisible="not(is_old_data) or quote_type != 'sales_quote'">
                        <label for="hubspot_reference"/>
                        <field name="hubspot_reference" class="oe_inline ps-5"
                               readonly="not user_is_planning_admin"
                               invisible="not is_old_data"/>
                        <button name="change_sale_ref_and_series"
                                type="object"
                                string="Modify Sequence"
                                class="btn-primary me-5 inline-block"
                                style="margin-right: 100px;"
                                invisible="not is_old_data"
                                confirm="Are you sure you want to proceed? This action will change the quotation reference and series."/>


                    </div>
                </xpath>

                <xpath expr="//group[@name='order_details']//field[@name='validity_date']" position="before">
                    <div class="o_row">
                        <label for="series_sequence_id"/>
                        <field name="series_sequence_id" class="oe_inline ps-5"
                               options="{'no_open':True,'no_create':True}"/>
                        <button name="action_generate_sale_order_number"
                                type="object"
                                string="Generate"
                                class="btn-primary me-5 inline-block"
                                style="margin-right: 100px;"
                                invisible="burgtec_quote_reference"
                                confirm="Are you sure"/>
                    </div>
                </xpath>


                <!-- NEW FLOW -->


                <xpath expr="//field[@name='series_sequence_id']" position="attributes">
                    <attribute name="readonly">burgtec_quote_reference</attribute>
                    <!--                    <attribute name="required">not burgtec_quote_reference</attribute>-->
                    <!--                                        <attribute name="required">not burgtec_quote_reference or (quote_type == 'sales_quote' and not is_having_project_stage) </attribute>-->

                </xpath>
                <xpath expr="//field[@name='delivery_stage']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//button[@name='action_show_delivery_orders']" position="attributes">
                    <attribute name="invisible">quote_type != 'project_quote'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                    <attribute name="invisible">quote_type != 'delivery_stage' or state == 'sale'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send'][1]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_quotation_send'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>

                    <!--                    <attribute name="invisible">quote_type in ('sales_quote', 'project_quote','delivery_stage')-->
                    <!--                    </attribute>-->
                </xpath>
                <xpath expr="//button[@name='action_quotation_send'][3]" position="attributes">
                    <attribute name="invisible">1</attribute>

                </xpath>
                <xpath expr="//button[@name='action_quotation_send'][4]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_quotation_confirm']" position="attributes">
                    <attribute name="invisible">1
                    </attribute>
                </xpath>
                <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_mark_as_quoation_sent']" position="attributes">
                    <attribute name="invisible">quote_type != 'sales_quote' or state != 'draft'</attribute>
                </xpath>
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d']" position="attributes">
                    <attribute name="invisible">quote_type != ('project_quote') or invoice_status != 'to invoice'
                    </attribute>
                    <attribute name="string">Create Claim
                    </attribute>

                    <!-- invoice_status != 'to invoice' -->
                </xpath>
                <xpath expr="//button[@name='action_unlock']"
                       position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="replace">
                    <!-- State field for sale_quote -->
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,sent"
                           invisible="quote_type != 'sales_quote'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="sale"
                           invisible="quote_type != 'delivery_stage'"/>
                </xpath>
                <xpath expr="//field[@name='quote_type']" position="attributes">
                    <attribute name="readonly">not is_old_data or is_having_project_stage or (is_old_data and quote_type
                        in ('sales_quote','delivery_stage'))
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage' and not(is_old_data)</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_invoice_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='sale_order_template_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='manual_rev']"
                       position="attributes">
                    <attribute name="invisible">quote_type in ('delivery_stage','project_quote')</attribute>
                </xpath>
                <xpath expr="//field[@name='custom_project_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='project_name']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='pricelist_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='date_order']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='validity_date']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>
                <xpath expr="//field[@name='zone_type']"
                       position="attributes">
                    <attribute name="readonly">quote_type == 'delivery_stage'</attribute>
                </xpath>


                <!-- BELOW IS THE CHECK AND CODE TO MAKE ALL FIELDS OF SALE ORDER LINE READONLY WHEN
                 THE PRODUCT IS FULLY APPROVED ON PLANNING SCREEN -->
                <xpath expr="//field[@name='order_line']//list//field[@name='product_id']"
                       position="after">
                    <field name="is_product_fully_approved" readonly="1" column_invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']"
                       position="attributes">
                    <attribute name="width">550px;</attribute>
                    <attribute name="readonly">is_product_fully_approved</attribute>
                    <attribute name="options">{'no_create_edit':True,'no_create': True,'no_open': True}</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='product_id']"
                       position="attributes">
                    <attribute name="width">550px;</attribute>
                    <attribute name="readonly">is_product_fully_approved</attribute>
                    <attribute name="options">{'no_create_edit':True,'no_create': True,'no_open': True}</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='product_packaging_qty']"
                       position="attributes">
                    <attribute name="optional">hide</attribute>
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='product_packaging_id']"
                       position="attributes">
                    <attribute name="optional">hide</attribute>
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='price_subtotal']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='price_total']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='price_total'][2]"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='discount']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='analytic_distribution']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='customer_lead']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='tax_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='route_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='image_128']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='product_packaging_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='custom_product_name']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']//list//field[@name='name']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <!-- BELOW IS THE CHECK AND CODE TO MAKE ALL FIELDS OF filtered_order_line_ids READONLY WHEN
                THE PRODUCT IS FULLY APPROVED ON PLANNING SCREEN -->
                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='product_id']"
                       position="after">
                    <field name="is_product_fully_approved" readonly="1" column_invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='product_template_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='product_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='product_uom_qty']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>


                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='price_unit']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='price_subtotal']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='price_total']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='price_total'][2]"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='discount']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='analytic_distribution']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='customer_lead']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>

                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='tax_id']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>
                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='custom_product_name']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>
                <xpath expr="//field[@name='filtered_order_line_ids']//list//field[@name='name']"
                       position="attributes">
                    <attribute name="readonly">is_product_fully_approved</attribute>
                </xpath>


                <xpath expr="//button[@name='action_show_delivery_orders']"
                       position="attributes">
                    <attribute name="string">View Delivery Orders</attribute>
                    <attribute name="invisible">not (is_old_data and (is_having_delivery_stage or quote_type in
                        ('delivery_stage')))
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="readonly">state == 'sale' or (quote_type == 'delivery_stage' and not is_old_data)
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='filtered_order_line_ids']" position="attributes">
                    <attribute name="readonly">state == 'sale' or (quote_type == 'delivery_stage' and not is_old_data)
                    </attribute>
                </xpath>

                <!-- NEW SALE ORDER LINE MODEL FOR DOWN PAYMENT -->
                <xpath expr="//page[@name='other_information']" position="before">
                    <page name="down_payment_order_lines" string="Down Payment Invoice Lines">
                        <field name="down_payment_order_line_ids" widget="sol_o2m"
                               readonly="state == 'cancel' or locked">
                            <list string="Down Payment Sales Order Lines"
                                  editable="bottom"
                                  limit="10"
                                  decoration-warning="state in ['draft', 'sent'] and is_product_archived"
                                  create="0"
                                  delete="0"
                            >

                                <field name="sequence" widget="handle"/>
                                <!-- We do not display the type because we don't want the user to be bothered with that information if he has no section or note. -->
                                <field name="display_type" column_invisible="True"/>
                                <field name="product_uom_category_id" column_invisible="True"/>
                                <field name="product_type" column_invisible="True"/>
                                <field name="product_updatable" column_invisible="True"/>
                                <field name="is_downpayment" column_invisible="True"/>
                                <field
                                        name="product_id"
                                        string="Product Variant"
                                        readonly="not product_updatable"
                                        required="not display_type and not is_downpayment"
                                        force_save="1"
                                        context="{
                                            'partner_id': parent.partner_id,
                                            'quantity': product_uom_qty,
                                            'pricelist': parent.pricelist_id,
                                            'uom':product_uom,
                                            'company_id': parent.company_id,
                                            'default_lst_price': price_unit,
                                            'default_uom_id': product_uom,
                                        }"
                                        options="{
                                            'no_open': True,
                                        }"
                                        optional="hide"
                                        domain="[('sale_ok', '=', True)]"
                                        widget="sol_product_many2one"/>
                                <field name="product_template_id"
                                       string="Product"
                                       readonly="id and not product_updatable"
                                       required="not display_type and not is_downpayment"
                                       context="{
                                            'partner_id': parent.partner_id,
                                            'quantity': product_uom_qty,
                                            'pricelist': parent.pricelist_id,
                                            'uom':product_uom,
                                            'company_id': parent.company_id,
                                            'default_list_price': price_unit,
                                            'default_uom_id': product_uom,
                                        }"
                                       options="{
                                            'no_open': True,
                                        }"
                                       optional="show"
                                       domain="[('sale_ok', '=', True)]"
                                       widget="sol_product_many2one"
                                       placeholder="Type to find a product..."/>
                                <field name="product_template_attribute_value_ids" column_invisible="1"/>
                                <field name="product_custom_attribute_value_ids" column_invisible="1">
                                    <list>
                                        <field name="custom_product_template_attribute_value_id"/>
                                        <field name="custom_value"/>
                                    </list>
                                </field>
                                <field name="product_no_variant_attribute_value_ids" column_invisible="1"/>
                                <field name="is_configurable_product" column_invisible="1"/>
                                <field name="linked_line_id" column_invisible="1"/>
                                <field name="virtual_id" column_invisible="1"/>
                                <field name="linked_virtual_id" column_invisible="1"/>
                                <field name="selected_combo_items" column_invisible="1"/>
                                <field name="combo_item_id" column_invisible="1"/>
                                <field
                                        name="name"
                                        widget="sol_text"
                                        optional="show"
                                />
                                <field name="analytic_distribution" widget="analytic_distribution"
                                       optional="hide"
                                       groups="analytic.group_analytic_accounting"
                                       options="{'product_field': 'product_id', 'business_domain': 'sale_order', 'amount_field': 'price_subtotal'}"/>
                                <field
                                        name="product_uom_qty"
                                        decoration-info="(not display_type and invoice_status == 'to invoice')"
                                        decoration-bf="(not display_type and invoice_status == 'to invoice')"
                                        context="{
                                            'partner_id': parent.partner_id,
                                            'quantity': product_uom_qty,
                                            'pricelist': parent.pricelist_id,
                                            'uom': product_uom,
                                            'company_id': parent.company_id
                                        }"
                                        readonly="is_downpayment"/>
                                <field
                                        name="qty_delivered"
                                        decoration-info="(not display_type and invoice_status == 'to invoice')"
                                        decoration-bf="(not display_type and invoice_status == 'to invoice')"
                                        string="Delivered"
                                        column_invisible="parent.state != 'sale'"
                                        readonly="qty_delivered_method != 'manual' or is_downpayment"
                                        optional="show"/>
                                <field name="qty_delivered_method" column_invisible="True"/>
                                <field
                                        name="qty_invoiced"
                                        decoration-info="(not display_type and invoice_status == 'to invoice')"
                                        decoration-bf="(not display_type and invoice_status == 'to invoice')"
                                        string="Invoiced"
                                        column_invisible="parent.state != 'sale'"
                                        optional="show"/>
                                <field name="qty_to_invoice" column_invisible="True"/>
                                <field name="product_uom_readonly" column_invisible="True"/>
                                <field name="product_uom" column_invisible="True" groups="!uom.group_uom"/>
                                <field
                                        name="product_uom"
                                        force_save="1"
                                        string="UoM"
                                        readonly="product_uom_readonly"
                                        required="not display_type and not is_downpayment"
                                        context="{'company_id': parent.company_id}"
                                        groups="uom.group_uom"
                                        options='{"no_open": True}'
                                        width="60px"
                                        optional="show"/>
                                <field
                                        name="customer_lead"
                                        optional="hide"
                                        width="80px"
                                        readonly="parent.state not in ['draft', 'sent', 'sale'] or is_downpayment"/>
                                <field name="product_packaging_qty"
                                       invisible="not product_id or not product_packaging_id"
                                       groups="product.group_stock_packaging" optional="show"/>
                                <field name="product_packaging_id" invisible="not product_id"
                                       context="{'default_product_id': product_id, 'list_view_ref':'product.product_packaging_tree_view', 'form_view_ref':'product.product_packaging_form_view'}"
                                       groups="product.group_stock_packaging" optional="show"/>
                                <field
                                        name="price_unit"
                                        readonly="qty_invoiced &gt; 0"/>
                                <field name="technical_price_unit" column_invisible="1"/>
                                <field
                                        name="tax_id"
                                        widget="many2many_tags"
                                        options="{'no_create': True}"
                                        domain="[('type_tax_use', '=', 'sale'), ('company_id', 'parent_of', parent.company_id), ('country_id', '=', parent.tax_country_id)]"
                                        context="{'active_test': True}"
                                        readonly="qty_invoiced &gt; 0 or is_downpayment"
                                        optional="show"/>
                                <field
                                        name="discount"
                                        string="Disc.%"
                                        groups="sale.group_discount_per_so_line"
                                        width="50px"
                                        optional="show"/>
                                <field name="is_downpayment" column_invisible="True"/>
                                <field name="price_subtotal"
                                       column_invisible="parent.company_price_include == 'tax_included'"
                                       invisible="is_downpayment"
                                       string="Amount"/>
                                <field name="price_total"
                                       column_invisible="parent.company_price_include == 'tax_excluded'"
                                       invisible="is_downpayment"
                                       string="Amount"/>
                                <!-- Optional amounts -->
                                <field name="price_total"
                                       column_invisible="parent.company_price_include == 'tax_included'"
                                       optional="hide"
                                       invisible="is_downpayment"
                                       string="Tax Incl."/>
                                <field name="price_subtotal"
                                       column_invisible="parent.company_price_include == 'tax_excluded'"
                                       optional="hide"
                                       invisible="is_downpayment"
                                       string="Tax Excl."/>
                                <!-- Others fields -->
                                <field name="tax_calculation_rounding_method" column_invisible="True"/>
                                <field name="state" column_invisible="True"/>
                                <field name="invoice_status" column_invisible="True"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="price_tax" column_invisible="True"/>
                                <field name="company_id" column_invisible="True"/>

                            </list>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//group[@name='project_rev_details']" position="inside">
                    <field name="site_address" invisible="quote_type == 'sales_quote'"/>/>
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='qty_delivered']" position="replace">
                    <field
                            name="qty_delivered"
                            decoration-info="(not display_type and invoice_status == 'to invoice')"
                            decoration-bf="(not display_type and invoice_status == 'to invoice')"
                            string="Delivered"
                            column_invisible="parent.quote_type != 'project_quote'"
                            readonly="qty_delivered_method != 'manual' or is_downpayment"
                    />
                </xpath>

                <xpath expr="//field[@name='order_line']//list//field[@name='qty_invoiced']" position="replace">
                    <field
                            name="qty_invoiced"
                            decoration-info="(not display_type and invoice_status == 'to invoice')"
                            decoration-bf="(not display_type and invoice_status == 'to invoice')"
                            string="Invoiced"
                            column_invisible="parent.quote_type != 'project_quote'"
                    />
                </xpath>

                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="burgtec_po_status" invisible="quote_type != 'delivery_stage'"/>
                </xpath>

            </field>
        </record>
        <record id="quote_type_customization_new_delivery_extend" model="ir.ui.view">
            <field name="name">quote.type.new.delivery.stage.sale.order.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="new_delivery_stage_feature.new_delivery_stage_sale_order_extend"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//list//field[@name='total_available_quantity']"
                       position="attributes">
                    <attribute name="column_invisible">parent.quote_type == 'sales_quote' or parent.quote_type == 'project_quote'
                    </attribute>
                </xpath>
            </field>
        </record>

    </data>


</odoo>