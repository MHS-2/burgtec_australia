        <record id="quotation_type_customization.planning_screen_ext" model="ir.ui.view">
            <field name="name">quote.type.customization.planning.screen</field>
            <field name="model">planning.screen</field>
            <field name="inherit_id" ref="new_delivery_stage_feature.planning_screen_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="create">false</attribute>
                    <attribute name="delete">false</attribute>
                    <attribute name="duplicate">false</attribute>
                </xpath>
                <xpath expr="//page[@name='planning_screen_lines']//field[@name='line_ids']" position="after">
                    <header>

                        <button name="action_split_delivery_excel_report" type="object" class="btn-success"
                                string="Print Excel Report"/>
                    </header>
                </xpath>
                <xpath expr="//field[@name='line_ids']//list/field[@name='product_reference']" position="before">
                    <field name="item" width="50px" force_save="1" class="text-start"/>
                    <field name="line_group_name" force_save="1" string='Group' width="200px" readonly="1" optional="show"/>
                    <field name="line_section_name" force_save="1" column_invisible="1" readonly="1"/>
                    <field name="line_group_id_value" force_save="1" column_invisible="1" readonly="1"/>
                    <field name="line_section_id_value" force_save="1" column_invisible="1" readonly="1"/>
                    <field name="code" string='Code' width="200px" force_save="1" optional="show"/>
                    <field name="product_name" width="200px" force_save="1" optional="show"/>
                    <field name="lead_time" width="100px" force_save="1" optional="show"/>
                    <field name="approval_required_by" width="200px" force_save="1" optional="show"/>
                    <field name="approval_method" readonly="approval_status_readonly" width="200px" force_save="1" optional="show"/>
                    <field name="approval_status_readonly" column_invisible="1" width="200px" force_save="1" />
                    <field name="approval_status" readonly="approval_status_readonly" width="200px" force_save="1" optional="show"/>
                    <field name="line_item_status" readonly="0" width="200px" force_save="1" optional="show"/>
                    <!--                           readonly="approval_status_readonly or not(approval_method)"/>-->
                    <field name="approval_comments" readonly="approval_status_readonly" width="160px" force_save="1" optional="show"/>
                    <field name="sales_comments" readonly="approval_status_readonly" width="160px" force_save="1" optional="show"/>
                    <field name="technical_comments" readonly="approval_status_readonly" width="160px" force_save="1" optional="show"/>
                    <field name="delivery_comments" readonly="False" width="160px" force_save="1" optional="show"/>
                    <field name="is_fully_approved" optional="show"
                           readonly="approval_status_readonly or not(approval_method) or not(approval_status)"
                           width="100px" class="text-center"/>
                    <field name="quantity" readonly="1" class="text-start" force_save="True" width="100"/>
                    <field name="total_available_quantity" string="Available Qty" readonly="1" class="text-center" force_save="True" width="106px"/>
                    <field name="do_stage_1" width="125px" force_save="1" class="text-center"
                           column_invisible="parent.stage_count &lt; 1"
                           readonly="parent.do_1_status in ('planned','confirmed')"/>
