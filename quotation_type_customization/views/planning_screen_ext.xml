                    <field name="product_id" width="350px" force_save="1" optional="show" readonly="1"/>
                    <field name="product_variant_id" optional="show" width="450px" force_save="1" readonly="1"/>

                </xpath>

                <xpath expr="//field[@name='product_reference']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']" position="before">
                    <group>
                        <group>
                            <field name="stage_count" style="width: 60px"/>
                        </group>
                    </group>
                </xpath>

                <xpath expr="//page[@name='planning_screen_lines']" position="after">
                     <page name="delivery_stage_cost" string="Delivery Stage Costs">
                            <group>
                                   <field name="zone_type"/>
                                   <field name="total_installation_cost"/>
                                   <field name="total_deleivery_cost"/>
                                   <field name="currency_id" invisible="1"/>
                            </group>
                            <field name="delivery_stage_cost_line_ids" no_label="1" force_save="1" widget="one2many">
                                   <list class="no_reorder" create="false" no_open="True" editable="bottom" delete="false">
                                          <field name="name" width="160px;" force_save="1"/>
                                          <field name="ds_quantity" width="100px;" string="Quantity" force_save="1" />
                                          <field name="ds_installation_cost" width="100px;" string="Installation Cost" force_save="1" sum="Total Installation Cost"/>
                                          <field name="ds_delivery_cost" width="100px;" string="Delivery Cost" force_save="1" sum="Total Delivery Cost"/>
                                          <field name="currency_id" column_invisible="1"/>
                                   </list>
                            </field>
