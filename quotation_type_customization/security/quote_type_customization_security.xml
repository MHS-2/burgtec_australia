<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_planning_screen_admin" model="res.groups">
            <field name="name">Planning Screen Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="comment">Users with full access to fully approve the product on planning screen</field>
        </record>
        <record id="group_super_admin" model="res.groups">
            <field name="name">Super Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Users of this group can delete the delivery stage</field>
        </record>
    </data>
</odoo>
