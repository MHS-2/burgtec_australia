<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_sync_hubspot_meetings" model="ir.cron">
        <field name="name">Sync HubSpot Meetings</field>
        <field name="model_id" ref="model_hubspot_meeting_data"/>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.import_all_meetings_from_hubspot()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">hours</field>
    </record>


    <record id="ir_cron_fetch_hubspot_meeting_types" model="ir.cron">
        <field name="name">Fetch Hubspot Meeting Types</field>
        <field name="model_id" ref="model_hubspot_meeting_data"/>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model.fetch_hubspot_meeting_types()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">hours</field>
    </record>



</odoo>