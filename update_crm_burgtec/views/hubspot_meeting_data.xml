<odoo>

    <!-- Tree View -->
    <record id="view_hubspot_meeting_list" model="ir.ui.view">
        <field name="name">hubspot.meeting.data.list</field>
        <field name="model">hubspot.meeting.data</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="hubspot_meeting_id" width="200px"/>
                <field name="name" width="400px"/>
                <field name="meeting_organized_by" width="150px"/>
                <field name="associated_companies" width="300px"/>
                <field name="associated_contacts" width="300px"/>
                <field name="meeting_type" width="200px"/>
                <field name="meeting_start_time" width="165px"/>
                <field name="meeting_end_time" width="165px"/>
                <field name="meeting_description" width=""/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hubspot_meeting_form" model="ir.ui.view">
        <field name="name">hubspot.meeting.data.form</field>
        <field name="model">hubspot.meeting.data</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="hubspot_meeting_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="meeting_organized_by" readonly="1"/>
                        <field name="associated_companies" readonly="1"/>
                        <field name="associated_contacts" readonly="1"/>
                        <field name="meeting_type" readonly="1"/>
                        <field name="meeting_start_time" readonly="1"/>
                        <field name="meeting_end_time" readonly="1"/>
                        <field name="meeting_description" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hubspot_meeting" model="ir.actions.act_window">
        <field name="name">HubSpot Meetings</field>
        <field name="res_model">hubspot.meeting.data</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_hubspot_meetings"
              name="Hubspot Meetings Data"
              action="action_hubspot_meeting"
              parent="sale.menu_sales_config"
              sequence="5"/>


</odoo>