<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View deal.pipeline.stage View List -->
    <record id="update_crm_burgtec_view_deal_pipeline_stage_list" model="ir.ui.view">
        <field name="name">view.deal.pipeline.stage.list</field>
        <field name="model">deal.pipeline.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hubspot_internal_name"/>
            </list>
        </field>
    </record>

    <!-- View deal.pipeline.stage form -->
    <record id="update_crm_burgtec_view_deal_pipeline_stage_form" model="ir.ui.view">
        <field name="name">view.deal.pipeline.stage.form</field>
        <field name="model">deal.pipeline.stage</field>
        <field name="arch" type="xml">
            <form string="Deal Pipeline Stage">
                <sheet>
                    <div class="oe_title">
                        <label for="hubspot_internal_name"/>
                        <h1>
                            <field name="hubspot_internal_name"/>

                        </h1>
                    </div>
                    <group>
                        <field name="name" placeholder="Name..." required="1"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View deal.pipeline.stage search -->
    <record id="update_crm_burgtec_view_deal_pipeline_stage_search" model="ir.ui.view">
        <field name="name">view.deal.pipeline.stage.search</field>
        <field name="model">deal.pipeline.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="hubspot_internal_name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'hubspot_internal_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action deal.pipeline.stage -->
    <record id="update_crm_burgtec_action_deal_pipeline_stage" model="ir.actions.act_window">
        <field name="name">Deal Pipeline Stage</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">deal.pipeline.stage</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Deal Pipeline Stage.
            </p>
        </field>
    </record>

    <menuitem
            id="update_crm_burgtec_pipeline_stage_menu"
            name="Pipeline Stage"
            action="update_crm_burgtec_action_deal_pipeline_stage"
            parent="update_crm_burgtec_hubspot_deals_menu"
            sequence="34"/>

</odoo>
