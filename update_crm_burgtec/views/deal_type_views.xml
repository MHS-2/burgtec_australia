<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View deal.type View List -->
    <record id="update_crm_burgtec_view_deal_type_list" model="ir.ui.view">
        <field name="name">update.crm.burgtec.view.deal.type.list</field>
        <field name="model">deal.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="hubspot_value"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- View deal.type form -->
    <record id="update_crm_burgtec_view_deal_type_form" model="ir.ui.view">
        <field name="name">update.crm.burgtec.view.deal.type.form</field>
        <field name="model">deal.type</field>
        <field name="arch" type="xml">
            <form string="Deal Type">
                <sheet>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="hubspot_value" required="0"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View deal.type search -->
    <record id="update_crm_burgtec_view_deal_type_search" model="ir.ui.view">
        <field name="name">update.crm.burgtec.view.deal.type.search</field>
        <field name="model">deal.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action deal.type -->
    <record id="update_crm_burgtec_action_deal_type" model="ir.actions.act_window">
        <field name="name">Deal Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">deal.type</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Deal Type.
            </p>
        </field>
    </record>

    <menuitem
        id="update_crm_burgtec_deal_type_menu"
        name="Deal Type"
        action="update_crm_burgtec_action_deal_type"
        parent="update_crm_burgtec_hubspot_deals_menu"
        sequence="32"/>
        
            

</odoo>
