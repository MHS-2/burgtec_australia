<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_hubspot" model="ir.ui.view">
        <field name="name">res.users.form.hubspot</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="HubSpot Data" name="hubspot">
                    <group string="HubSpot Details">
                        <field name="hubspot_user_id" readonly="1" invisible="1"/>
                        <field name="hubspot_owner_id" readonly="1"/>
                        <field name="hubspot_user_url" readonly="1" widget="url"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
