<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="update_crm_burgtec.sale_order_ext1" model="ir.ui.view">
        <field name="name">update_crm_burgtec.sale.order.form.series_sequence1</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="quotation_type_customization.sale_order_ext"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_row']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_show_child_sale_orders']" position="before">
                <button name="action_view_opportunity"
                        type="object"
                        string="Deal"
                        class="oe_stat_button"
                        icon="fa-handshake-o"
                        invisible="not opportunity_id"/>
            </xpath>
            <xpath expr="//field[@name='burgtec_quote_reference']" position="attributes">
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//page[@name='report_config']//field[@name='is_show_total_breakdown']" position="before">
                <field name="pdf_report_name" string="PDF File Name"/>
            </xpath>

            <xpath expr="//field[@name='manual_rev']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='custom_project_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

<!--            <xpath expr="//group[@name='project_rev_details']" position="inside">-->
<!--                <field name="site_address" invisible="quote_type == 'sales_quote'"/>/>-->
<!--            </xpath>-->

        </field>
    </record>

    <record id="update_crm_burgtec.view_order_form_modify" model="ir.ui.view">
        <field name="name">update_crm_burgtec.view.order.form.modify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="update_crm_burgtec.view_order_list_modify" model="ir.ui.view">
        <field name="name">update_crm_burgtec.view.order.list.modify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

        </field>
    </record>

    <record id="update_crm_burgtec.sale_order_list_upload_modify" model="ir.ui.view">
        <field name="name">update_crm_burgtec.sale.order.list.upload.modify</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_list_upload"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

        </field>
    </record>

    <record id="update_crm_burgtec.view_sale_order_kanban_modify" model="ir.ui.view">
        <field name="name">update_crm_burgtec.view.sale.order.kanban</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="create">0</attribute>
            </xpath>

        </field>
    </record>

    <menuitem id="update_crm_burgtec_menu_crm_leads_from_sale_order"
              parent="sale.sale_order_menu"
              name="Deals"
              action="crm.crm_lead_action_pipeline"
              groups="sales_team.group_sale_salesman"
              sequence="0"/>

    <record model="ir.ui.menu" id="sale_custom_report.menu_sale_quotations_with_sales_quote_type">
        <field name="sequence">1</field>
    </record>

    <record model="ir.ui.menu" id="sale_custom_report.menu_sale_quotations_with_project_quote_type">
        <field name="sequence">2</field>
    </record>

    <record model="ir.ui.menu" id="sale_custom_report.menu_sale_quotations_with_delivery_stage_quote_type">
        <field name="sequence">3</field>
    </record>

    <record model="ir.ui.menu" id="sale.menu_sale_quotations">
        <field name="name">All Quotations</field>
    </record>

</odoo>
