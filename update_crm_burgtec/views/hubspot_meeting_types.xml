<odoo>

    <!-- Tree View -->
    <record id="view_hubspot_meeting_types_list" model="ir.ui.view">
        <field name="name">hubspot.meeting.types.list</field>
        <field name="model">hubspot.meeting.types</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">

                <field name="name" width="400px"/>
                <field name="hubspot_internal_name" width="200px"/>

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hubspot_meeting_types_form" model="ir.ui.view">
        <field name="name">hubspot.meeting.types.form</field>
        <field name="model">hubspot.meeting.types</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="flase">
                <sheet>
                    <group>

                        <field name="name" readonly="1"/>
                        <field name="hubspot_internal_name" readonly="1"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_view_hubspot_meeting_types" model="ir.actions.act_window">
        <field name="name">HubSpot Meeting Types</field>
        <field name="res_model">hubspot.meeting.types</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_hubspot_meeting_types"
              name="Hubspot Meeting Types"
              action="action_view_hubspot_meeting_types"
              parent="sale.menu_sales_config"
              sequence="6"/>


</odoo>