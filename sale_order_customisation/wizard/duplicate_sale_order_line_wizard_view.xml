<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_duplicate_quotation_line_wizard_form" model="ir.ui.view">
        <field name="name">duplicate.quotation.line.wizard.form</field>
        <field name="model">duplicate.quotation.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Product">
                <div class="alert alert-danger" role="alert" invisible="not is_no_admin_right">
                    ⚠️ Attention: You dont have any Admin right for Sales or Project!.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not is_admin">
                    ⚠️ Attention: You are admin for both Sales and Project! Select quote type manually.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not show_warning">
                    ⚠️ Attention: This line is being duplicated to another sales order.
                </div>
                <group>
                    <header>
                        <h1>
                            <field name="display_name" readonly="True"/>
                        </h1>
                    </header>
                    <field string="Product" name="order_line_id" context="{'duplicate_line':1}" options="{'no_create_edit': True, 'no_open': True}" readonly="True"/>
                    <field name="quote_type" readonly="not is_admin or is_no_admin_right" invisible="is_no_admin_right"/>
                    <field name="order_id" string="Quote" invisible="quote_type or is_no_admin_right" context="{'group_swap':1}" options="{'no_open':1,'no_create':1,'search_view_ref': 'sale_custom_report.sale_custom_report_inherit_view_search'}"/>
                    <field name="order_id" string="Quote" invisible="not quote_type or quote_type == 'project_quote' or is_no_admin_right" domain="[('quote_type','=','sales_quote')]" context="{'group_swap':1}" options="{'no_open':1,'no_create':1,'search_view_ref': 'sale_custom_report.sale_custom_report_inherit_view_search'}"/>
                    <field name="order_id" string="Quote" invisible="not quote_type or quote_type == 'sales_quote' or is_no_admin_right" domain="[('quote_type','=','project_quote')]" context="{'group_swap':1}" options="{'no_open':1,'no_create':1,'search_view_ref': 'sale_custom_report.sale_custom_report_inherit_view_search'}"/>
                    <field name="group_id" context="{'group_swap':1}" invisible="is_no_admin_right" options="{'no_open':1,'no_create':1,'list_view_ref': 'sale_order_customisation.sale_order_customisation_sale_order_list_view','search_view_ref': 'sale_order_customisation.sale_order_customisation_sale_order_search_view'}"/>
                    <field name="section_id" context="{'group_swap':1}" invisible="is_no_admin_right" options="{'no_open':1,'no_create':1,'list_view_ref': 'sale_order_customisation.sale_order_customisation_sale_order_list_view','search_view_ref': 'sale_order_customisation.sale_order_customisation_sale_order_search_view'}"/>
                </group>
                <footer>
                    <button string="Duplicate" class="btn btn-primary" type="object" name="action_duplicate"
                            data-hotkey="q" invisible="is_no_admin_right"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>