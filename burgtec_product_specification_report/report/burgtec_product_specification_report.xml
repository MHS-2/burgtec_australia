    <record id="paperformat_product_specification_report" model="report.paperformat">
        <field name="name">Burgtec Delivery Report Paperformat</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_product_specification_report" model="ir.actions.report">
        <field name="name">Burgtec Product Specification Report</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">burgtec_product_specification_report.product_specification_report</field>
        <field name="report_file">burgtec_product_specification_report.product_specification_report</field>
        <!--        <field name="print_report_name">'Burgtec - %s' % (object.burgtec_quote_reference)</field> -->
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <!--        <field name="domain">[('quote_type','=','delivery_stage')]</field>-->
        <field name="paperformat_id"
               ref="burgtec_product_specification_report.paperformat_product_specification_report"/>
    </record>
</odoo>
