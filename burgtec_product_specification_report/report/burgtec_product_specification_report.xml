                        </div>

                        <!-- Project Quantity -->
                        <div style="font-size: 18px; color: #000000; margin-bottom: 20px;">
                            Product QTY:
                            <span t-esc="line.product_uom_qty"/>
                        </div>

                        <!-- Features and Finishes Section -->
                        <div style="margin-bottom: 50px;">
                            <t t-set="description_parts" t-value="spec_line.name.split('\n', 1)"/>
                            <t t-set="description"
                               t-value="description_parts[1] if len(description_parts) > 1 else line.name"/>

                            <!-- Extract Dimensions -->
                            <t t-set="dimensions_start" t-value="description.find('Dimensions:')"/>
                            <t t-set="dimensions_end"
                               t-value="description.find('Features:') if description.find('Features:') > dimensions_start else (description.find('Finishes:') if description.find('Finishes:') > dimensions_start else (description.find('Warranty:') if description.find('Warranty:') > dimensions_start else len(description)))"/>
                            <t t-set="dimensions_text"
                               t-value="description[dimensions_start + 11:dimensions_end].strip() if dimensions_start >= 0 else ''"/>

                            <!-- Extract Features -->
                            <t t-set="features_start" t-value="description.find('Features:')"/>
                            <t t-set="features_end"
                               t-value="description.find('Finishes:') if description.find('Finishes:') > features_start else (description.find('Warranty:') if description.find('Warranty:') > features_start else len(description))"/>
                            <t t-set="features_text"
                               t-value="description[features_start + 9:features_end].strip() if features_start >= 0 else ''"/>

                            <!-- Extract Finishes -->
                            <t t-set="finishes_start" t-value="description.find('Finishes:')"/>
                            <t t-set="finishes_end"
                               t-value="description.find('Warranty:') if description.find('Warranty:') > finishes_start else (description.find('Lead Time:') if description.find('Lead Time:') > finishes_start else len(description))"/>
                            <t t-set="finishes_text"
                               t-value="description[finishes_start + 9:finishes_end].strip() if finishes_start >= 0 else ''"/>

                            <!-- Display Dimensions -->
                            <div t-if="dimensions_text" style="margin-bottom: 20px;">
                                <h3 style="font-size:18px; font-weight:bold; color:#000000; margin:0 0 10px 0;">
                                    Dimensions
                                </h3>
                                <p style="font-size:18px; margin:0;">
                                    <ul style="list-style-type: disc; padding-left:18px; margin: 0; font-size:18px; line-height:1.6;">
                                        <li style="margin-bottom:4px;">
                                            <span t-esc="dimensions_text"/>
                                        </li>
                                    </ul>
                                </p>
                            </div>

                            <!-- Features and Finishes Table -->
                            <table style="width:100%; border-collapse: collapse;" t-if="features_text or finishes_text">
                                <tr>
                                    <!-- Features column -->
                                    <td style="width:50%; vertical-align: top; padding-right: 30px;"
                                        t-if="features_text">
                                        <h3 style="font-size:18px; font-weight:bold; color:#000000; margin:0 0 15px 0;">
                                            Features
                                        </h3>
                                        <ul style="list-style-type: disc; padding-left:18px; margin: 0; font-size:18px; line-height:1.6;">
                                            <!-- Split features by common patterns and create list items -->
                                            <t t-set="feature_items"
                                               t-value="[item.strip() for item in features_text.replace(' Mid Back ', '\nMid Back ').replace(' Gas-lift ', '\nGas-lift ').replace(' Adjustable ', '\nAdjustable ').replace(' Synchronized ', '\nSynchronized ').replace(' Fixed ', '\nFixed ').replace(' 5 star ', '\n5 star ').split('\n') if item.strip() and len(item.strip()) > 3]"/>
                                            <t t-foreach="feature_items" t-as="feature">
                                                <li style="margin-bottom:4px;">
                                                    <span t-esc="feature"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </td>

                                    <!-- Finishes column -->
                                    <td style="width:50%; vertical-align: top;"
                                        t-if="finishes_text">
                                        <h3 style="font-size:18px; font-weight:bold; color:#000000; margin:0 0 15px 0;">
                                            Finishes
                                        </h3>
                                        <ul style="list-style-type: disc; padding-left:18px; margin: 0; font-size:18px; line-height:1.6;">
                                            <!-- Split finishes and create list items -->
                                            <t t-set="finish_items"
                                               t-value="[item.strip() for item in finishes_text.replace('Upholstery: ', '\nUpholstery: ').replace(' base', '\nbase').split('\n') if item.strip() and len(item.strip()) > 3]"/>
                                            <t t-foreach="finish_items" t-as="finish">
                                                <li style="margin-bottom:4px;">
                                                    <span t-esc="finish"/>
                                                </li>
                                            </t>
                                        </ul>
                                    </td>
                                </tr>
                            </table>
                        </div>


                        <!-- Footer Section -->
