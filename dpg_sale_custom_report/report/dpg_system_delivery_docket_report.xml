<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="dpg_system_delivery_docket">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">
                    <!-- Article Section -->

                    <div class="article" style="padding: 50px 20px 0;">
                        <div class="row"
                             style="display: table; width: 100%; table-layout: fixed;">

                            <div class="col-6"
                                 style="display: table-cell; width: 50%; vertical-align: top; padding: 0;">

                                <img t-att-src="'/dpg_sale_custom_report/static/img/DPG_Logo.png'"
                                     alt="Image Description" style="max-height: 120px; max-width: 90%;display: block;"/>

                            </div>

                            <div class="col-6"
                                 style="display: table-cell; width: 50%; vertical-align: top; padding: 0;">
                                <table class="table table-borderless"
                                       style="width: 100%; border-collapse: collapse; margin: 0;">
                                    <tr>
                                        <td style="text-align: right; padding: 0 0 6px 0;vertical-align: top;">
                                            <span style="font-family: 'Fonetika-Light'; font-size: 25px;">
                                                <strong>DELIVERY DOCKET</strong>
                                            </span>
                                        </td>
                                    </tr>

                                </table>
                            </div>

                        </div>

                        <div style="clear: both; height: 35px;"></div>


                        <div style="width: 100%;">
                            <table class="table table-borderless"
                                   style=" width: 100%; table-layout: fixed; border-collapse: collapse;">
                                <tr>
                                    <td style="width: 50%; text-align: left; padding: 0px 10px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <strong>DPG SYSTEMS</strong>
                                        </span>
                                    </td>

                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <strong>Delivery Docket #:</strong>
                                        </span>
                                    </td>
                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <t t-out="'DD-90001'"/>
                                        </span>
                                    </td>
                                </tr>

                                <!-- ABN / Customer Name -->
                                <tr>
                                    <td style="width: 50%; text-align: left; padding: 0px 10px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-size: 15px;">
                                            <strong>ABN:</strong>
                                            <t t-out="'95 639 808 754'"/>
                                        </span>
                                    </td>

                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <strong>Date:</strong>
                                        </span>
                                    </td>

                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>

                                        </span>
                                    </td>
                                </tr>

                                <!-- address -->
                                <tr>
                                    <td style="width: 50%; text-align: left; padding: 0 10px 5px 10px; border:none; vertical-align: top;">
                                        <span style="font-size: 15px;">
                                            10A Corella Close,Berkeley Vale NSW 2261

                                        </span>
                                    </td>

                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <strong>PO #:</strong>
                                        </span>
                                    </td>
                                    <td style="width: 25%; text-align: left; padding: 0px 0px 0px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <t t-out="o.custom_po_no"/>

                                        </span>
                                    </td>
                                </tr>


                                <tr>
                                    <td style="width: 50%; text-align: left;  border:none; vertical-align: top;">
                                    </td>

                                    <td style="width: 25%; text-align: left; padding: 0px 0px 5px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <strong>Delivery Method:</strong>
                                        </span>
                                    </td>
                                    <td style="width: 25%; text-align: left; padding: 0px 0px 5px 10px; border:none; vertical-align: top;">
                                        <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                            <t t-out="'900012-001'"/>

                                        </span>
                                    </td>
                                </tr>

                            </table>
                        </div>

                        <div style="clear: both; height: 35px;"></div>


                        <div style="width:100%; margin:0; padding:0;">
                            <table class="table table-borderless"
                                   style=" width:100%; border-collapse:collapse;table-layout:fixed;border:1px solid #E4E5E6;background-color:#F4F7F9; margin:0; padding:0; ">
                                <tr>
                                    <!-- LEFT SIDE -->
                                    <td style="width:50%;vertical-align:top; border:none; padding:10px 15px; ">

                                        <table class="table table-borderless"
                                               style=" width:100%; border-collapse:collapse; table-layout:fixed; margin:0;  padding:0; ">

                                            <colgroup>
                                                <col style="width:38%;"/>
                                                <col style="width:62%;"/>
                                            </colgroup>

                                            <!-- DELIVER TO -->
                                            <tr>
                                                <td colspan="2"
                                                    style=" border:none;  padding:0 0 5px 0; vertical-align:top; ">
                                                    <span style="  font-family:'Fonetika-Light';   font-size:15px; ">
                                                        <strong>DELIVER TO:</strong>
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- CUSTOMER -->
                                            <tr>
                                                <td style="border:none; padding:0px 8px 0px 0px; vertical-align:top; ">
                                                    <span style="font-family:'Fonetika-Light'; font-size:15px; ">
                                                        <strong>Customer:</strong>
                                                    </span>
                                                </td>

                                                <td style=" border:none; padding:0px 8px 0px 0px; vertical-align:top; white-space:normal;word-wrap:break-word; overflow-wrap:break-word; ">
                                                    <span style="font-family:'Fonetika-Light';font-size:15px;white-space:normal; word-wrap:break-word;">
                                                        <t t-out="o.partner_id.name"/>
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- DELIVERY ADDRESS -->
                                            <tr>
                                                <td style=" border:none; padding:0px 8px 0px 0px;vertical-align:top; white-space:nowrap;">
                                                    <span style="font-family:'Fonetika-Light'; font-size:15px; white-space:nowrap;">
                                                        <strong>Delivery Address:</strong>
                                                    </span>
                                                </td>

                                                <td style=" border:none; padding:0px 8px 0px 0px;vertical-align:top;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;">
                                                    <span style="font-family:'Fonetika-Light';font-size:15px;white-space:normal; word-wrap:break-word;overflow-wrap:break-word; ">

                                                       <t t-out="o.customer_address"/>

                                                    </span>
                                                </td>
                                            </tr>

                                        </table>
                                    </td>


                                    <!-- RIGHT SIDE -->
                                    <td style="  width:50%; vertical-align:top;border:none; padding:10px 15px;">

                                        <table style=" width:100%; border-collapse:collapse; table-layout:fixed; margin:0; padding:0;">

                                            <colgroup>
                                                <col style="width:32%;"/>
                                                <col style="width:68%;"/>
                                            </colgroup>

                                            <!-- CONTACT / REFERENCE -->
                                            <tr>
                                                <td colspan="2"
                                                    style="border:none;padding:0 0 5px 0;vertical-align:top;">
                                                    <span style=" font-family:'Fonetika-Light'; font-size:15px; white-space:nowrap;">
                                                        <strong>CONTACT / REFERENCE:</strong>
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- CONTACT -->
                                            <tr>
                                                <td style=" border:none; padding:0px 8px 0px 0; vertical-align:top; ">
                                                    <span style=" font-family:'Fonetika-Light'; font-size:15px; ">
                                                        <strong>Contact:</strong>
                                                    </span>
                                                </td>

                                                <td style=" border:none; padding:0px 8px 0px 0;;vertical-align:top;white-space:normal; word-wrap:break-word;">
                                                    <span style=" font-family:'Fonetika-Light';font-size:15px;">
                                                        <t t-out="o.partner_id.phone"/>
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- PHONE -->
                                            <tr>
                                                <td style="border:none; padding:0px 8px 0px 0; vertical-align:top;">
                                                    <span style="font-family:'Fonetika-Light'; font-size:15px; ">
                                                        <strong>Phone:</strong>
                                                    </span>
                                                </td>

                                                <td style="border:none; padding:0px 8px 0px 0; vertical-align:top;white-space:normal; word-wrap:break-word;">
                                                    <span style="font-family:'Fonetika-Light'; font-size:15px; ">
                                                        <t t-out="o.partner_id.mobile"/>
                                                    </span>
                                                </td>
                                            </tr>

                                            <!-- SITE / JOB -->
                                            <tr>
                                                <td style=" border:none;padding:0px 8px 0px 0;vertical-align:top;">
                                                    <span style=" font-family:'Fonetika-Light'; font-size:15px; ">
                                                        <strong>Site / Job:</strong>
                                                    </span>
                                                </td>

                                                <td style=" border:none;padding:0px 8px 0px 0;vertical-align:top;white-space:normal; word-wrap:break-word; overflow-wrap:break-word; ">
                                                    <span style="font-family:'Fonetika-Light'; font-size:15px;">
                                                        <t t-out="o.partner_id.function"/>
                                                    </span>
                                                </td>
                                            </tr>

                                        </table>

                                    </td>

                                </tr>
                            </table>
                        </div>


                        <div style="clear: both; height: 30px;"></div>

                        <div class="row" style="page-break-inside:avoid;break-inside:avoid;">
                            <table class="table"
                                   style="width:100%;table-layout:fixed;border-collapse:collapse;border:1px solid #D3D3D3;">

                                <thead style="page-break-inside:avoid;break-inside:avoid;">
                                    <tr style="text-align:left !important;">

                                        <th style="width:15%;padding:18px;background-color:#236184;color:white;vertical-align:middle;border:1px solid #D3D3D3;">
                                            PRODUCT
                                        </th>

                                        <th style="width:35%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            DESCRIPTION
                                        </th>

                                        <th style=" width:16%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            QUANTITY
                                            <br/>
                                            ORDERED
                                        </th>

                                        <th style="width:17%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            QUANTITY
                                            <br/>
                                            DELIVERED
                                        </th>

                                        <th style="width:17%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            BACKORDER /
                                            <br/>
                                            NOTES
                                        </th>

                                    </tr>
                                </thead>


                                <tbody>

                                    <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)"
                                       t-as="line">

                                        <tr>

                                            <td style=" text-align:center; vertical-align:top;padding:10px;border:1px solid #D3D3D3; ">
                                                <span t-field="line.custom_product_name"/>
                                            </td>

                                            <td style="text-align:left;vertical-align:top;padding:10px; white-space:normal; word-wrap:break-word;border:1px solid #D3D3D3;">
                                                <span t-field="line.name"/>
                                            </td>

                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="line.product_uom_qty"/>
                                            </td>
                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="line.product_uom_qty"/>
                                            </td>

                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="''"/>
                                            </td>
                                        </tr>
                                    </t>

                                </tbody>

                            </table>
                        </div>

                        <div style="clear: both; height: 55px;"></div>

                        <div class="row" style="page-break-inside:avoid;break-inside:avoid;">
                            <table style="width:100%;table-layout:fixed;margin-top:30px;border-collapse:collapse;border:1px solid #D3D3D3;background-color:#F4F5F6;">
                                <tr>
                                    <td style="padding:14px 18px; border:1px solid #D3D3D3;  text-align:left;vertical-align:middle; ">
                                        <span style="font-family:'Fonetika-Light';font-size:15px;color:#34495E;">
                                            <strong>DELIVERY NOTES:</strong>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:45px;border:1px solid #D3D3D3;padding:0;">
                                    </td>
                                </tr>
                                <tr>
                                    <td style="height:45px;border:1px solid #D3D3D3;padding:0;">
                                    </td>
                                </tr>

                            </table>
                        </div>

                        <div style="clear: both; height: 70px;"></div>

                        <table class="table table-borderless"
                               style="width:100%;table-layout:fixed;border-collapse:collapse;margin-top:30px;">
                            <tr>
                                <td style="width:33.33%;padding:0 15px;vertical-align:top;border:none;">
                                    <div style="font-size:15px;color:#34495E;font-weight:bold;margin-bottom:35px;">
                                        <strong>RECEIVED BY:</strong>
                                    </div>
                                    <div style="width:100%;border-bottom:1px solid #000;"></div>
                                </td>

                                <td style="width:33.33%;padding:0 15px;vertical-align:top; border:none;">
                                    <div style="font-size:15px;color:#34495E;font-weight:bold;margin-bottom:35px;">
                                        <strong>DATE:</strong>
                                    </div>
                                    <div style="width:100%;border-bottom:1px solid #000;"></div>
                                </td>

                                <td style="width:33.33%;padding:0 15px;vertical-align:top; border:none;">
                                    <div style="font-size:15px;color:#34495E;font-weight:bold;margin-bottom:35px;">
                                        <strong>DELIVERY DRIVER:</strong>
                                    </div>
                                    <div style="width:100%;border-bottom:1px solid #000;"></div>
                                </td>
                            </tr>
                        </table>


                        <div style="clear: both; height: 70px;"></div>


                        <div style="width:100%;padding:20px 0px 0 0px; page-break-inside:avoid;break-inside:avoid;">
                            <div class="row" style="width:100%;border:1px solid black;margin-bottom:15px;">

                            </div>
                            <table class="table table-borderless"
                                   style=" width:100%; border-collapse:collapse;table-layout:fixed; ">
                                <tr>
                                    <td style="width:65%;text-align:left;padding:0; border:none; vertical-align:middle; ">
                                        <span style="font-size:15px;">
                                            Signature
                                        </span>
                                    </td>


                                    <td style=" width:35%;  text-align:right;  padding:0; border:none;vertical-align:middle;  ">
                                        <span style="font-size:15px;">
                                            Signature / Name
                                        </span>
                                    </td>

                                </tr>
                            </table>
                        </div>

                        <div style="clear: both; height: 40px;"></div>


                        <div class="footer" style="width:100%;padding:20px 0px 0 0px;">
                            <div class="row" style="width:100%;border:1px solid black;margin-bottom:15px;">

                            </div>
                            <table class="table table-borderless"
                                   style=" width:100%; border-collapse:collapse;table-layout:fixed; ">
                                <tr>
                                    <td style="width:75%;text-align:left;padding:0; border:none; vertical-align:middle; ">
                                        <span style="font-size:15px;">
                                            <strong>DPG SYSTEMS</strong>
                                            |
                                            ABN 95 639 808 754
                                            |
                                            10A Corella Close, Berkeley Vale NSW 2261
                                        </span>
                                    </td>


                                    <td style=" width:25%;  text-align:right; padding:0; border:none;vertical-align:middle;  ">
                                        <span style="font-size:15px;">
                                            Delivery Docket
                                        </span>
                                    </td>

                                </tr>
                            </table>
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>


    <record id="paperformat_dpg_system_delivery_docket_report" model="report.paperformat">
        <field name="name">Dpg System Delivery Report Paperformat</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_dpg_system_delivery_docket_report" model="ir.actions.report">
        <field name="name">DGP System Delivery Docket Report</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dpg_sale_custom_report.dpg_system_delivery_docket</field>
        <field name="report_file">dpg_sale_custom_report.dpg_system_delivery_docket</field>
        <field name="print_report_name">'DPG Delivery Docket - %s' % (object.burgtec_quote_reference)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="dpg_sale_custom_report.paperformat_dpg_system_delivery_docket_report"/>
    </record>
</odoo>

