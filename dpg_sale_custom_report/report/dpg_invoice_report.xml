                        <div style="width:100%; margin:0; padding:0;">

                            <table class="table table-borderless" style="
            width:100%;
            table-layout:fixed;
            border-collapse:collapse;
            margin:0;
            padding:0;
            color:#34495E;
            font-family:'Fonetika-Light';
            font-size:15px;
            line-height:1.4;
        ">
                                <tr>

                                    <!-- LEFT SIDE -->
                                    <td style="
                    width:50%;
                    vertical-align:top;
                    border:none;
                    padding:0 10px;
                ">

                                        <div style="font-weight:bold;">
                                            DPG SYSTEMS
                                        </div>

                                        <div>
                                            <strong>ABN:</strong>
                                            95 639 808 754
                                        </div>

                                        <div>
                                            10A Corella Close,
                                        </div>

                                        <div>
                                            Berkeley Vale NSW 2261
                                        </div>

                                    </td>


                                    <!-- RIGHT SIDE -->
                                    <td style="
                width:50%;
                vertical-align:top;
                border:none;
                padding:0;
            ">

                                        <table style="
                        width:100%;
                        border-collapse:collapse;
                        table-layout:fixed;
                        margin:0;
                        padding:0;
                        font-size:15px;
                        line-height:1.4;
                        color:#34495E;
                    ">

                                            <colgroup>
                                                <col style="width:22%;"/>
                                                <col style="width:78%;"/>
                                            </colgroup>

                                            <!-- INVOICE -->
                                            <tr>
                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                            font-weight:bold;
                            white-space:nowrap;
                        ">
                                                    Invoice #:
                                                </td>

                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                        ">
                                                    <t t-out="'INV-90001'"/>
                                                </td>
                                            </tr>

                                            <!-- PO NUMBER -->
                                            <tr>
                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                            font-weight:bold;
                            white-space:nowrap;
                        ">
                                                    PO #:
                                                </td>

                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                        ">
                                                    <t t-out="o.custom_po_no"/>
                                                </td>
                                            </tr>

                                            <!-- DATE -->
                                            <tr>
                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                            font-weight:bold;
                            white-space:nowrap;
                        ">
                                                    Date:
                                                </td>

                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                        ">
                                                    <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                                </td>
                                            </tr>

                                            <!-- DUE DATE -->
                                            <tr>
                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                            font-weight:bold;
                            white-space:nowrap;
                        ">
                                                    Due Date:
                                                </td>

                                                <td style="border:none; padding:0; vertical-align:top;  ">
                                                    <t t-if="o.validity_date">
                                                        <t t-out="o.validity_date.strftime('%d/%m/%Y')"/>
                                                    </t>
                                                </td>
                                            </tr>

                                            <!-- VALIDITY -->
                                            <tr>
                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                            font-weight:bold;
                            white-space:nowrap;
                        ">
                                                    Validity:
                                                </td>

                                                <td style="
                            border:none;
                            padding:0;
                            vertical-align:top;
                        ">
                                                    30 Days
                                                </td>
                                            </tr>

                                        </table>

                                    </td>

                                </tr>
                            </table>

                        </div>

                        <div style="clear: both; height: 35px;"></div>


                        <div style="width:100%; margin:0; padding:0;">
                            <table style="
                                    width:100%;
                                    border-collapse:collapse;
                                    table-layout:fixed;
                                    border:1px solid #D3D3D3;
                                    background-color:#F4F5F6;
                                    margin:0;
                                ">
                                <tr>
                                    <td style="
                                        width:100%;
                                        vertical-align:top;
                                        padding:8px 12px 16px 12px;
                                        border:none;
                                        text-align:left;
                                    ">

                                        <!-- HEADING -->
                                        <div style="
                                                font-family:'Fonetika-Light';
                                                font-size:15px;
                                                font-weight:bold;
                                                color:#34495E;
                                                margin-bottom:4px;
                                            ">
                                            PREPARED FOR:
                                        </div>

                                        <!-- CUSTOMER NAME -->
                                        <div style="
                                                font-family:'Fonetika-Light';
                                                font-size:15px;
                                                color:#34495E;
                                                line-height:1.5;
                                            ">
                                            <t t-out="o.partner_id.name"/>
                                        </div>

                                        <!-- ADDRESS -->
                                        <div style="
                                            font-family:'Fonetika-Light';
                                            font-size:15px;
                                            color:#34495E;
                                            line-height:1.5;
                                            white-space:normal;
                                            word-wrap:break-word;
                                        ">
                                            <t t-out="o.customer_address"/>


                                        </div>

                                    </td>
                                </tr>
                            </table>
                        </div>


                        <div style="clear: both; height: 30px;"></div>

                        <div class="row" style="page-break-inside:avoid;break-inside:avoid;">
                            <table class="table"
                                   style="width:100%;table-layout:fixed;border-collapse:collapse;border:1px solid #D3D3D3;">

                                <thead style="page-break-inside:avoid;break-inside:avoid;">
                                    <tr style="text-align:left !important;">

                                        <th style="width:15%;padding:18px;background-color:#236184;color:white;vertical-align:middle;border:1px solid #D3D3D3;">
                                            PRODUCT
                                        </th>

                                        <th style="width:35%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            DESCRIPTION
                                        </th>

                                        <th style=" width:16%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            PRICE
                                            <br/>
                                            (EX-GST)
                                        </th>

                                        <th style="width:17%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            QUANTITY
                                        </th>

                                        <th style="width:17%;padding:18px;background-color:#236184;color:white;text-align:center;vertical-align:middle;border:1px solid #D3D3D3;">
                                            TOTAL
                                            <br/>
                                            (EX-GST)
                                        </th>

                                    </tr>
                                </thead>


                                <tbody>

                                    <t t-foreach="o.order_line.filtered(lambda l: not l.display_type)"
                                       t-as="line">

                                        <tr>

                                            <td style=" text-align:center; vertical-align:top;padding:10px;border:1px solid #D3D3D3; ">
                                                <span t-field="line.custom_product_name"/>
                                            </td>

                                            <td style="text-align:left;vertical-align:top;padding:10px; white-space:normal; word-wrap:break-word;border:1px solid #D3D3D3;">
                                                <span t-field="line.name"/>
                                            </td>

                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="o.currency_id.symbol"/>
                                                <t t-out="'{:,.2f}'.format(line.price_unit)"/>
                                            </td>
                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="line.product_uom_qty"/>
                                            </td>

                                            <td style="text-align:center;vertical-align:top;padding:10px;white-space:nowrap;border:1px solid #D3D3D3;">
                                                <t t-out="o.currency_id.symbol"/>
                                                <t t-out="'{:,.2f}'.format(line.price_subtotal)"/>
                                            </td>
                                        </tr>
                                    </t>

                                </tbody>

                            </table>
                        </div>

                        <div style="clear: both; height: 40px;"></div>


                        <div class="row">
                            <div class="col-4"></div>
                            <div class="col-4"></div>
                            <div class="col-4">
                                <table class="table table-borderless"
                                       style="width: 100%; float: right; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align: right; padding: 0 0 6px 0; vertical-align: bottom;">
                                            <span style="font-family: 'Fonetika-Light'; font-weight: 100; font-size: 15px;">
                                                Subtotal (EX-GST):
                                            </span>
                                        </td>
                                        <td></td>
                                        <td style="text-align: right; padding: 0 0 6px 0; vertical-align: top; line-height:1;">
                                            <span style="font-size: 15px;">
                                                <t t-out="o.currency_id.symbol"/>
                                                <t t-out="'{:,.2f}'.format(o.amount_untaxed)"/>

                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="text-align: right; padding: 0 0 6px 0; vertical-align: top; line-height:1;">
                                            <span style="font-size: 15px;">
                                                GST (10%):
                                            </span>
                                        </td>
                                        <td></td>
                                        <td style="text-align: right; padding: 0 0 6px 0; vertical-align: top; line-height:1;">
                                            <span style="font-size: 15px;">
                                                <t t-out="o.currency_id.symbol"/>
                                                <t t-out="'{:,.2f}'.format(o.amount_tax)"/>
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div style="clear: both; height: 0px;"></div>

                        <div style="width: 45%; float: right; border-top: 2.5px solid #000000;"></div>


                        <div style="clear: both; height: 6px;"></div>

                        <div class="row">
                            <div class="col-4"></div>
                            <div class="col-4"></div>
                            <div class="col-4">
                                <table class="table table-borderless"
                                       style="width: 100%; float: right; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align: right; padding: 0 25px 6px 0; vertical-align: bottom;">
                                            <span style="font-family: 'Fonetika-Light'; font-size: 15px;">
                                                <strong>Total (Inc-GST):</strong>
                                            </span>
                                        </td>
                                        <td></td>
                                        <td style="text-align: right; padding: 0 0 6px 0; vertical-align: top; line-height:1;">
                                            <strong>
                                                <span style="font-size: 15px;">
                                                    <t t-out="o.currency_id.symbol"/>
                                                    <t t-out="'{:,.2f}'.format(o.amount_total)"/>
                                                </span>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div style="clear: both; height: 55px;"></div>


                        <div class="table table-borderless"
                             style="width:100%; margin-top:45px; page-break-inside:avoid;">

                            <table style="
                                width:100%;
                                table-layout:fixed;
                                border-collapse:collapse;
                                margin:0;
                                padding:0;
                            ">
                                <tr>

                                    <!-- PAYMENT OPTIONS -->
                                    <td style="
                                        width:48%;
                                        vertical-align:top;
                                        padding:0 12px 0 0;
                                        border:none;
                                    ">

                                        <div style="
                                            background-color:#F4F7F9;
                                            border:1px solid #D9DDE1;
                                            padding:8px 12px;
                                            font-size:15px;
                                            line-height:1.4;
                                            font-family:'Fonetika-Light';
                                            color:#34495E;
                                        ">

                                            <div style="font-weight:bold; margin-bottom:2px;">
                                                PAYMENT OPTIONS:
                                            </div>

                                            <div>
                                                Please remit payments via Electronic Funds Transfer (EFT)
                                                <br/>
                                                directly to the account details below:
                                            </div>

                                            <div style="margin-top:22px;">
                                                <strong>Bank:</strong>
                                                Westpac Banking Corporation
                                                <br/>

                                                <strong>BSB:</strong>
                                                032-523
                                                <br/>

                                                <strong>Account Number:</strong>
                                                423 623
                                                <br/>

                                                <strong>Account Name:</strong>
                                                Kennard Group Holdings
                                            </div>

                                        </div>

                                    </td>


                                    <!-- TERMS & CONDITIONS -->
                                    <td style="
                                        width:52%;
                                        vertical-align:top;
                                        padding:7px 0 0 0;
                                        border:none;
                                    ">

                                        <div style="
                                            font-size:15px;
                                            line-height:1.4;
                                            font-family:'Fonetika-Light';
                                            color:#34495E;
                                        ">

                                            <div style="font-weight:bold; margin-bottom:2px;">
                                                Terms &amp; Conditions:
                                            </div>

                                            <div>
                                                1. All invoices are strictly due within 30 days from the date of issue.
                                                <br/>

                                                2. Custom manufactured items entail a standard 6-8 week lead time
                                                unless specified otherwise.
                                                <br/>

                                                3. Standard commercial warranties apply to softwired modules
                                                and cable basket componentry.
                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            </table>

                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>


    <record id="paperformat_dpg_invoice_report" model="report.paperformat">
        <field name="name">Dpg Invoice Report Paperformat</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_dpg_invoice_report" model="ir.actions.report">
        <field name="name">DGP Invoice Report</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dpg_sale_custom_report.dpg_invoice_report</field>
        <field name="report_file">dpg_sale_custom_report.dpg_invoice_report</field>
        <field name="print_report_name">'DPG Invoice - %s' % (object.burgtec_quote_reference)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="dpg_sale_custom_report.paperformat_dpg_invoice_report"/>
    </record>
</odoo>

