<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List  View for Components -->
    <record id="sale_order_bom_component_line_view_list" model="ir.ui.view">
        <field name="name">sale.order.bom.component.line.view.list</field>
        <field name="model">sale.order.bom.component.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="component_id" widget="many2onebutton"/>
                <field name="order_line_id"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="product_qty"/>
                <field name="unit_sale_price"/>
                <field name="total_sale_price"/>
                <field name="manual_live_unit_cost"/>
                <field name="live_unit_cost"/>
            </list>
        </field>
    </record>


    <record id="action_sale_order_bom_component_line" model="ir.actions.act_window">
        <field name="name">BOM Components Line</field>
        <field name="res_model">sale.order.bom.component.line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sale_order_bom_component_line"
              name="Component Lines"
              action="action_sale_order_bom_component_line"
              parent="sale.menu_sales_config"
              sequence="999"/>

</odoo>
