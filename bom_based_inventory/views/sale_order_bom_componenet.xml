<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View for Components -->
    <record id="view_sale_order_bom_components_form" model="ir.ui.view">
        <field name="name">sale.order.bom.components.form</field>
        <field name="model">sale.order.bom.component</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <field name="show_warning" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not show_warning">
                    ⚠️ Attention: You have added a product that is not part of the original BOM.
                    Please ensure the quantity matches your requirements as it won't be automatically
                    adjust with parent product quantity.
                </div>
                <field name="show_live_percentage_warning" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="not show_live_percentage_warning">
                    ⚠️ Attention: The Percentage Margin of Live cost is maybe wrong.Please check once.
                </div>
                <header>
                    <button string="Fetch Quoted Cost"
                            class="btn oe_stat_button"
                            type="object"
                            name="action_quoted_cost"
                    />
                    <button string="Fetch Pre Project Cost"
                            class="btn oe_stat_button"
                            type="object"
                            name="action_fetch_pre_project_cost"
                    />
                    <button string="Fetch Live Cost"
                            class="btn oe_stat_button"
                            type="object"
                            name="action_fetch_live_cost"
                            invisible="1"

                    />
                    <button name="action_view_sale_order"
                            string="Back to Sale Order"
                            type="object"
                            class="btn oe_stat_button"
                    />

                </header>
                <sheet>
                    <group>
                        <field name="order_id" readonly="1" invisible="1"/>
                        <field name="state" readonly="1" invisible="1"/>
                        <field name="view_team" string="View Type" placeholder="Default View"/>
                        

                    </group>

                    <field name="component_line_ids"
                           widget="section_and_note_one2many"
                           mode="list"
                           no_label="True"
                           invisible="view_team"
                           readonly="state == 'sale'"
                    >
                        <list class="no_reorder"
                              create="0"
                              limit="10"
                              editable="bottom"
                              decoration-success="is_parent == True"
                              decoration-warning="is_other_than_bom == True"
                              decoration-info="is_parent == False">



                            <!-- Section header fields -->
                            <field name="sequence" widget="handle" invisible="1"/>
                            <field name="display_type" column_invisible="1" string=" "/>
                            <field name="name"
                                   widget="sol_text"
                                   force_save="1" string="" readonly="1"/>

                            <!-- Existing data columns -->
                            <field name="is_other_than_bom"
                                   column_invisible="1" force_save="1"/>
                            <!--                            <field name="parent_number" column_invisible="0" class="bright-red text-start"-->
                            <!--                            invisible="not is_parent and is_new_bom_line"/>-->


                            <button name="action_open_add_components_wizard"
                                    string="Add Components"
                                    type="object"
                                    class="btn-primary btn-sm"
                                    icon="fa-plus"
                                    invisible="not is_parent"
                                    help="Add components to this parent line"/>
                            <field name="parent_product_code" width="100px" force_save="1" readonly="1"
                                   invisible="not is_parent"
                                   class="bright-red text-start"/>
                            <field name="parent_product_reference"
                                   column_invisible="1" force_save="1"/>
                            <field name="order_line_id"
                                   column_invisible="1" force_save="1"/>

                            <field name="parent_product_id"
                                   column_invisible="1" force_save="1" readonly="1"/>
                            <field name="is_auto_generated" column_invisible="1"/>
                            <field name="is_readonly" column_invisible="1" force_save="1"/>
                            <field name="is_parent" column_invisible="1" force_save="1"/>
                            <field name="current_change" column_invisible="1" force_save="1"
                                   readonly="parent.state == 'sale'"/>
                            <!--                            <field name="line_id"/>-->
                            <field name="product_reference"
                                   readonly="1" force_save="1" column_invisible="1"/>
                            <field name="product_id" width="500px"
                                   options="{'no_open':1,'no_create':1}"
                                   readonly="parent.state == 'sale' or is_readonly"
                                   force_save="1" style="color:green;" required="1"/>
                            <field name="product_name" optional="hide" width="350px" readonly="1" force_save="1"/>
                            <field name="product_qty"
                                   width="60px"
                                   readonly="parent.state == 'sale'" force_save="1"/>
                            <field name="unit_sale_price" width="100px"
                                   readonly="parent.state == 'sale'"
                                   force_save="1"/>
                            <field name="total_sale_price" width="100px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1"/>
                            <field name="note" force_save="1" readonly="is_parent"/>
                            <field name="system_cost_per_unit" width="140px"
                                   readonly="1" force_save="1"
                                   decoration-muted="1 == 1" optional="hide"/>
                            <field name="quoted_cost_per_unit" width="140px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1" decoration-danger="1 == 1" optional="hide"/>
                            <field name="pre_project_cost_per_unit" width="150px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1"
                                   decoration-primary="1 == 1"
                                   decoration-bf="1 == 1" optional="hide"/>
                            <field name="manual_live_unit_cost" readonly="is_parent" force_save="1" optional="show"
                                   decoration-warning="1 == 1" decoration-bf="1 == 1"/>
                            <field name="live_unit_cost" width="100px"
                                   readonly="1"
                                   force_save="1" decoration-warning="1 == 1" optional="hide"/>
                            <field name="supplier_id"
                                   readonly="parent.state == 'sale'" options="{'no_create':1}" optional="hide"/>
                            <field name="margin_system_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-muted="1 == 1"
                                   optional="hide"/>
                            <field name="margin_quoted_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-danger="1 == 1"
                                   optional="hide"/>
                            <field name="margin_pre_project_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-primary="1 == 1"
                                   decoration-bf="1 == 1" optional="hide"/>
                            <field name="margin_live_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-warning="1 == 1"
