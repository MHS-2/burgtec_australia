                            <field name="total_sale_price" width="100px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1"/>
                            <field name="note" force_save="1" readonly="is_parent" optional="hide"/>
                            <field name="system_cost_per_unit" width="140px"
                                   readonly="1" force_save="1"
                                   decoration-muted="1 == 1" optional="hide"/>
                            <field name="quoted_cost_per_unit" width="140px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1" decoration-danger="1 == 1" optional="hide"/>
                            <field name="pre_project_cost_per_unit" width="150px"
                                   readonly="parent.state == 'sale' or is_parent"
                                   force_save="1"
                                   decoration-primary="1 == 1"
                                   decoration-bf="1 == 1" optional="hide"/>
                            <field name="manual_live_unit_cost" readonly="is_parent" force_save="1" optional="show"
                                   decoration-warning="1 == 1" decoration-bf="1 == 1"/>
                            <field name="live_unit_cost" width="100px"
                                   readonly="1"
                                   force_save="1" decoration-warning="1 == 1" optional="hide"/>
                            <field name="supplier_id"
                                   readonly="parent.state == 'sale'" options="{'no_create':1}" optional="hide"/>
                            <field name="margin_system_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-muted="1 == 1"
                                   optional="hide"/>
                            <field name="margin_quoted_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-danger="1 == 1"
                                   optional="hide"/>
                            <field name="margin_pre_project_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-primary="1 == 1"
                                   decoration-bf="1 == 1" optional="hide"/>
                            <field name="margin_live_cost"
                                   readonly="1" force_save="1" invisible="not is_parent" decoration-warning="1 == 1"
                                   optional="hide"/>

                            <!-- these fields are to show % margin and markup for each parent line on bom component screen -->
                            <field name="margin_system_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-muted="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="margin_quoted_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-danger="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="margin_pre_project_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-primary="1 == 1"
                                   decoration-bf="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="margin_live_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-warning="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="markup_system_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-muted="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="markup_quoted_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-danger="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="markup_pre_project_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-primary="1 == 1"
                                   decoration-bf="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                            <field name="markup_live_cost_per_parent"
                                   readonly="1" force_save="1"
                                   invisible="not is_parent"
                                   decoration-warning="1 == 1"
                                   optional="hide"
                                   widget="percentage"/>

                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sale_order_bom_components" model="ir.actions.act_window">
        <field name="name">BOM Components</field>
        <field name="res_model">sale.order.bom.component</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sale_order_bom_components_form"/>
        <field name="target">new</field>
    </record>

</odoo>
