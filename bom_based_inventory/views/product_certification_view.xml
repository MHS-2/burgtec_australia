<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="bom_based_inventory.product_certification_list_view" model="ir.ui.view">
        <field name="name">bom_based_inventory.product.certification.list.view</field>
        <field name="model">product.certification</field>
        <field name="arch" type="xml">
            <list string="Product Certification">
                <field name="name"/>
                <field name="description"/>
                <field name="certification_logo" widget="image" options="{'size': [85, 85]}"/>
            </list>
        </field>
    </record>

    <record id="bom_based_inventory.view_product_certification_search" model="ir.ui.view">
        <field name="name">bom_based_inventory.view.product.certification.search</field>
        <field name="model">product.certification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>


    <record id="bom_based_inventory.view_product_certification_form" model="ir.ui.view">
        <field name="name">bom_based_inventory.view.product.certification.form</field>
        <field name="model">product.certification</field>
        <field name="arch" type="xml">

            <form string="Product Certification">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="certification_logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" required="1" placeholder="e.g. Certification Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_certification" model="ir.actions.act_window">
        <field name="name">Product Certification</field>
        <field name="res_model">product.certification</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="menu_product_certification"
              name="Product Certification"
              parent="stock.menu_stock_inventory_control"
              action="action_product_certification"/>

</odoo>









