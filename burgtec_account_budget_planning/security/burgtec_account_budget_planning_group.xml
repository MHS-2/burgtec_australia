<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_burgtec_warehouse_parent" model="ir.module.category">
        <field name="name">Burgtec Account Budget Planning</field>
        <field name="description">Helps you handle Burgtec Account Budget Planning module's operations</field>
        <field name="sequence">100</field>
    </record>


    <record model="ir.module.category" id="module_category_burgtec_account_budget_planning_id">
        <field name="name">Account Budget Planning</field>
        <field name="description">Helps manage warehouse app permissions.</field>
        <field name="sequence">40</field>
        <field name="parent_id" ref="burgtec_account_budget_planning.module_category_burgtec_warehouse_parent"/>
    </record>

    <record id="group_account_budget_user" model="res.groups">
        <field name="name">User: Read Only</field>
        <field name="category_id" ref="burgtec_account_budget_planning.module_category_burgtec_account_budget_planning_id"/>
    </record>

    <record id="group_account_budget_manager" model="res.groups">
        <field name="name">Manager: Manage all operations</field>
        <field name="category_id" ref="burgtec_account_budget_planning.module_category_burgtec_account_budget_planning_id"/>
        <field name="implied_ids" eval="[(4,ref('burgtec_account_budget_planning.group_account_budget_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>

    <record id="group_account_budget_superuser" model="res.groups">
        <field name="name">Super User: Can Do Anything!</field>
        <field name="category_id" ref="burgtec_account_budget_planning.module_category_burgtec_account_budget_planning_id"/>
        <field name="implied_ids" eval="[(4,ref('burgtec_account_budget_planning.group_account_budget_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>


</odoo>
