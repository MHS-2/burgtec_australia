<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_target_type_list" model="ir.ui.view">
        <field name="name">budget.target.type.list</field>
        <field name="model">budget.target.type</field>
        <field name="arch" type="xml">
            <list string="Target Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_budget_target_type_form" model="ir.ui.view">
        <field name="name">budget.target.type.form</field>
        <field name="model">budget.target.type</field>
        <field name="arch" type="xml">
            <form string="Target Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Churn"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_target_type_search" model="ir.ui.view">
        <field name="name">budget.target.type.search</field>
        <field name="model">budget.target.type</field>
        <field name="arch" type="xml">
            <search string="Target Types">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_budget_target_type" model="ir.actions.act_window">
        <field name="name">Budget Target Types</field>
        <field name="res_model">budget.target.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first target type.
            </p>
            <p>Examples: Churn, Major Projects, New Business.</p>
        </field>
    </record>

</odoo>
