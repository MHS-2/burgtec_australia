            <field name="model">planning.screen</field>
            <field name="inherit_id" ref="quotation_type_customization.planning_screen_ext"/>
            <field name="arch" type="xml">


                <xpath expr="//field[@name='stage_count']/parent::group" position="after">
                    <group>
                        <field name="show_planned_stages" invisible="1"/>
                        <button name="action_toggle_planned_stages" type="object" string="Show Planned Stages"
                        invisible="show_planned_stages" class="btn-primary"/>
                        <button name="action_toggle_planned_stages" type="object" string="Hide Planned Stages"
                                invisible="not show_planned_stages" class="btn-primary"/>
                    </group>
                </xpath>

                <!-- 3. Stage columns 1-50 -->
                <xpath expr="//field[@name='line_ids']//list/field[@name='do_stage_1']" position="attributes">
                    <attribute name="readonly">parent.do_1_status in ('planned','confirmed','new')</attribute>
                    <attribute name="decoration-danger">parent.do_1_status == 'planned'</attribute>
                    <attribute name="decoration-info">parent.do_1_status != 'planned'</attribute>
