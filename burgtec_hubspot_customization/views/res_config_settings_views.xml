<odoo>
    <record id="res_config_settings_view_form_ext" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.ext</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='connectors_setting_container']" position="after">
                <block title="Hubspot Configuration" id="hubspot_settings_container">
                    <setting id="hubspot_integration_url" help="Add hubspot base url">
                        <field name="hubspot_base_url"/>
                    </setting>
                    <setting id="hubspot_integration" help="Add hubspot integration token">
                        <field name="hubspot_integrations_token"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>