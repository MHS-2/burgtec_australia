<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="burgtec_hubspot_customization.view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">burgtec.hubspot.customization purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="dispatch_arrival_mismatch" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="is_manual_expected_arrival"/>
                <field name="hubspot_dispatch_date" readonly="1"/>
                <field name="last_po_weekly_update_date" readonly="0"/>
                <field name="po_weekly_update_date_tracking" invisible="1"/>
                <field name="overdue_po_weekly_update" readonly="1"/>
                <field name="po_due_in_two_days" readonly="1"/>
                <field name="po_due_after_dispatch" readonly="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-warning text-center" role="alert" invisible="not dispatch_arrival_mismatch">
                    <h3>⚠️ Dispatch Date is earlier than Arrival Date !</h3>
                </div>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                 <attribute name="readonly">not is_manual_expected_arrival</attribute>
                 <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="burgtec_hubspot_customization.purchase_order_kpis_tree_inherit_fields" model="ir.ui.view">
        <field name="name">burgtec_hubspot_customization.purchase.order.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">

            <field name="date_planned" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <xpath expr="//field[@name='date_planned']" position="after">
                <field name="hubspot_dispatch_date"/>
            </xpath>
        </field>
    </record>
</odoo>
