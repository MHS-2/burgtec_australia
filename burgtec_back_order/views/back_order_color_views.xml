<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View back.order.color View List -->
    <record id="view_back_order_color_list" model="ir.ui.view">
        <field name="name">view.back.order.color.list</field>
        <field name="model">back.order.color</field>
        <field name="arch" type="xml">
            <list>
                <field name="back_order_count"/>
                <field name="color"/>
            </list>
        </field>
    </record>

    <!-- View back.order.color form -->
    <record id="view_back_order_color_form" model="ir.ui.view">
        <field name="name">view.back.order.color.form</field>
        <field name="model">back.order.color</field>
        <field name="arch" type="xml">
            <form string="Back Order Color">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="back_order_count"/>
                        <widget name="customcolorpicker" invisible="not id"/>
                        <field name="color" readonly="1" force_save="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View back.order.color search -->
    <record id="view_back_order_color_search" model="ir.ui.view">
        <field name="name">view.back.order.color.search</field>
        <field name="model">back.order.color</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action back.order.color -->
    <record id="action_back_order_color" model="ir.actions.act_window">
        <field name="name">Back Order Color</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">back.order.color</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Back Order Color.
            </p>
        </field>
    </record>
    

    <menuitem
        id="menu_back_order_conf_sales"
        name="Back Order"
        parent="sale.menu_sale_config"
        sequence="999"/>
    
    <menuitem id="menu_back_order_color_sales"
              name="Back Order Color"
              action="action_back_order_color"
              parent="menu_back_order_conf_sales"
              sequence="1"/>
    
    <menuitem
        id="menu_back_order_conf_purchase"
        name="Back Order"
        parent="purchase.menu_purchase_config"
        sequence="999"/>
    
    <menuitem id="menu_back_order_color_purchase"
            name="Back Order Color"
            action="action_back_order_color"
            parent="menu_back_order_conf_purchase"
            sequence="1"/>
    

</odoo>
