<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="rfq_vendor_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.supplier_id.lang)"/>
                <div class="page">
                    <div class="article">
                        <div class="row">
                            <div class="col-12">
                                <h2 class="text-start"
                                    style="font-size: 38px; transform: scaleX(1.4); transform-origin: left;">
                                    <strong>
                                        burgtec.
                                    </strong>
                                </h2>
                            </div>
                        </div>

                        <!-- Clear separation between divs -->
                        <div style="clear: both; height: 30px;"></div>


                        <div class="row">
                            <div class="col-12">
                                <div style="display: block; margin-bottom: 5px; line-height: 1.0; font-size: 16px; color: grey;">
                                    <span>10A Corella Close, Berkeley Vale NSW 2261</span>
                                </div>
                                <div style="display: block; margin-bottom: 5px; line-height: 1.0; font-size: 16px; color: grey;">
                                    <span>
                                        estimating@burgtec.com
                                    </span>
                                </div>
                                <div style="display: block; margin-bottom: 5px; line-height: 1.0; font-size: 16px; color: grey;">
                                    <span>
                                        1800 287 483
                                    </span>
                                </div>
                                <div style="display: block; line-height: 1.0; font-size: 16px; color: grey;">
                                    <span>
                                        ABN:95 639 808 754
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="row" style="margin-top: 75px;">
                            <div class="col">

                                <strong>Shipping address</strong>
                                <t t-if="o.partner_shipping_id">
                                    <span t-field="o.partner_shipping_id"
                                          t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
                                          />
                                </t>

                            </div>
                            <div class="col">
                                <strong>Vendor</strong>
                                <t t-if="o.supplier_id">

                                    <span t-field="o.supplier_id"
                                          t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                                </t>
                            </div>
                        </div>
                        <div class="row" style="margin-top: 30px;">
                            <div class="col">
                                <h2>Request for Quotation #
                                    <span t-out="o.order_id.burgtec_quote_reference"/>
                                </h2>

                            </div>
                        </div>

                        <!-- Clear separation between divs -->
                        <div style="clear: both; height: 30px;"></div>

                        <div id="informations" class="row mb-4">
                            <div t-if="o.create_date" class="col-3 bm-2">
                                <strong>Creation Date:</strong>
                                <p t-out="context_timestamp(current_date).strftime('%d %b %Y')" class="m-0"/>
                            </div>

                        </div>

                        <div class="row">
                            <div class="col-12">
                                <table class="o_has_total_table table o_main_table table-borderless">
                                    <thead class="border-bottom">
                                        <tr>
                                            <th name="th_code" class="text-start">
                                                <strong>G.Code</strong>
                                            </th>
                                            <th name="th_code" class="text-start">
                                                <strong>Code</strong>
                                            </th>
                                            <th name="th_product_name" class="text-start">
                                                <strong>Product Name</strong>
                                            </th>
                                            <th name="th_note" class="text-start">
                                                <strong>Note</strong>
                                            </th>
                                            <th name="th_quantity" class="text-end">
                                                <strong>Qty</strong>
                                            </th>
                                            <th name="th_price_unit" class="text-end">
                                                <strong>Unit Cost</strong>
                                            </th>
                                            <!-- <th name="th_taxes" class="text-end">
                                                <strong>Taxes</strong>
                                            </th> -->
                                            <th name="th_subtotal" class="text-end">
                                                <strong>Amount</strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="current_subtotal" t-value="0"/>
                                        <t t-set="vendor_lines" t-value="o.component_id.vendor_component_line_ids.filtered(lambda c:c.supplier_id.id == o.supplier_id.id)"/> 
                                        <t t-foreach="vendor_lines" t-as="line">
                                            <t t-set="current_subtotal"
                                               t-value="current_subtotal + line.total_live_unit_cost"/>

                                            <tr t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                <t t-if="not line.display_type">
                                                    <td id="group_code" class="text-start">
<!--                                                        <span t-out="line.line_section_name_child"/>-->
                                                        <span t-out="line.parent_product_code"/>
                                                    </td>
                                                    <td id="product_code" class="text-start">
                                                        <span t-field="line.product_id.default_code"/>
                                                    </td>
                                                    <td id="product_name" class="text-start">
                                                        <span t-field="line.product_id.name"/>
                                                    </td>
                                                    <td id="product_note" class="text-start">
                                                        <span t-field="line.note"/>
                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.product_qty"/>
                                                        <span t-field="line.product_id.uom_name" groups="uom.group_uom"/>

                                                    </td>
                                                    <td class="text-end">
                                                        <span t-field="line.manual_live_unit_cost"
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>

                                                    <td class="text-end">
                                                        <span t-field="line.total_live_unit_cost"
                                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Clear separation between divs -->
                        <div style="clear: both; height: 20px;"></div>

                        <div id="total" class="row justify-content-end mt-n3">
                            <div class="col-4">
                                <table class="o_total_table table table-borderless border-top border-bottom">
                                    <!--Total amount-->
                                    <tr class="o_total">
                                        <td><strong>Total</strong></td>
                                        <td class="text-end">
                                            <strong t-out="current_subtotal"
                                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}'
                                            >31.05</strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>


                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_burgtec_proforma_purchase_report" model="report.paperformat">
        <field name="name">Burgtec Proforma Vendor Purchase Report Paperformat</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_rfq_vendor_report" model="ir.actions.report">
        <field name="name">Proforma Vendor Report</field> <!-- Name -->
        <field name="model">component.lines.by.vendor</field> <!-- Model to be used for this action/template -->
        <field name="report_type">qweb-pdf</field> <!-- report type  -->
        <field name="report_name">update_proforma_rfq_screen.rfq_vendor_report</field> <!-- Model name . id of the above template external id-->
        <field name="report_file">update_proforma_rfq_screen.rfq_vendor_report</field> <!-- Model name . id of the above template external id-->
        <field name="print_report_name">('Proforma RFQ  - %s' % (object.order_id.burgtec_quote_reference))</field> <!-- PDF name when downloaded -->
        <field name="binding_model_id" ref="update_proforma_rfq_screen.model_component_lines_by_vendor"/> <!-- Bind so that we can use the print functionality to download and see the report. -->
        <field name="binding_type">report</field>  <!-- Bind so that we can use the print functionality to download and see the report. -->
        <field name="paperformat_id" ref="update_proforma_rfq_screen.paperformat_burgtec_proforma_purchase_report"/>
    </record>
</odoo>