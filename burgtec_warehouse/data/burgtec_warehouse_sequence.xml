<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <data noupdate="1">
       <record id="ir_sequence_burgtec_warehouse" model="ir.sequence">
           <field name="name">Burgtec Warehouse Serial Number</field>
           <field name="code">burgtec.warehouse</field>
           <field name="prefix">WHR/%(year)s/</field>
           <field name="padding">5</field>
           <field name="number_next">1</field>
           <field name="number_increment">1</field>
           <field name="company_id" eval="False"/>
       </record>

       <record id="ir_sequence_burgtec_dispatching" model="ir.sequence">
           <field name="name">Burgtec Dispatching Serial Number</field>
           <field name="code">burgtec.dispatching</field>
           <field name="prefix">DSPCH/%(year)s/</field>
           <field name="padding">5</field>
           <field name="number_next">1</field>
           <field name="number_increment">1</field>
           <field name="company_id" eval="False"/>
       </record>
   </data>
</odoo>
