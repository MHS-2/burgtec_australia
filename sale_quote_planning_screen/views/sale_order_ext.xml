<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_quote_planning_screen.sale_order_ext" model="ir.ui.view">
        <field name="name">sale.quote.planning.screen.sale.order.ext</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="quotation_type_customization.sale_order_ext"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_show_component']" position="after">
                <button name="action_show_sale_quote_planning_screen" string="Sale Quote Planning Screen" type="object" icon="fa-eye"
                        invisible="quote_type != 'sales_quote'"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_line_from_sale_quote_planning_screen" model="ir.ui.view">
        <field name="name">view.sale.order.line.from.sale.quote.planning.screen</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="View Sale Order Product Line">
                <sheet>
                    <group>
                        <group>
                            <field name="custom_product_name" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="image_128" widget="image"
                                   options="{'size': [200, 200]}" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer></footer>
            </form>
        </field>
    </record>
</odoo>
