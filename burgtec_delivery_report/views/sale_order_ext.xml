<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="burgtec_delivery_report_customization_sale_order_extend" model="ir.ui.view">
        <field name="name">burgtec.delivery.report.sale.order.extend</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='project_rev_details']" position="inside">
                <field name="qr_url" invisible="quote_type != 'delivery_stage'" widget="url" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>