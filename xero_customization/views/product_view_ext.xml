    <record id="xero_connector_product_product_only_form_view_ext" model="ir.ui.view">
        <field name="name">product.product.form.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="sync_xero_connector.xero_connector_product_normal_form_view"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//field[@name='default_code']" position="attributes">-->
<!--                <attribute name="required">0</attribute>-->
<!--            </xpath>-->

            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-success text-start d-inline-flex"
                    invisible="not product_xero_company_ids"
                    role="alert">This product has been exported to Xero.</div>
                <div class="alert alert-danger text-start d-inline-flex"
                    invisible="product_xero_company_ids"
                    role="alert">This product has not been exported to Xero yet.</div>
            </xpath>

            <xpath expr="//page[@name='invoicing']" position="after">
                <page name="xero_product_data" string="XERO Details">
                    <field name="product_xero_company_ids" readonly="1">
                        <list editable="bottom">
                            <field name="company_id"/>
                            <field name="xero_item_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>