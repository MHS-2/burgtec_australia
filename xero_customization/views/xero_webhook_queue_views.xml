<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View xero.webhook.queue View List -->
    <record id="view_xero_webhook_queue_list" model="ir.ui.view">
        <field name="name">view.xero.webhook.queue.list</field>
        <field name="model">xero.webhook.queue</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="datetime"/>
                <field name="payload"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- View xero.webhook.queue form -->
    <record id="view_xero_webhook_queue_form" model="ir.ui.view">
        <field name="name">view.xero.webhook.queue.form</field>
        <field name="model">xero.webhook.queue</field>
        <field name="arch" type="xml">
            <form string="Xero Webhook Queue" create="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="datetime"/>
                        <field name="payload"/>
                    </group>
                    <notebook>
                        <page name="event_lines" string="Event">
                            <field name="xero_event_line_ids" widget="one2many">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="event_category"/>
                                    <field name="event_type"/>
                                    <field name="resource_id"/>
                                    <field name="resource_url"/>
                                    <field name="tenant_id"/>
                                    <field name="tenant_type"/>
                                    <field name="event_date_char"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action xero.webhook.queue -->
    <record id="action_xero_webhook_queue" model="ir.actions.act_window">
        <field name="name">Xero Webhook Queue</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">xero.webhook.queue</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Xero Webhook Queue.
            </p>
        </field>
    </record>

    <menuitem id="menu_webhook_queue" name="Xero Webhook Queue" parent="sync_xero_connector.menu_xero_main" action="action_xero_webhook_queue" sequence="3"/>


</odoo>
