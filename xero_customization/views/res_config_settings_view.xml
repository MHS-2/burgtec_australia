<odoo>
    <record id="res_config_settings_view_form_xero_webhook_ext" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.xero.webhook.ext</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='audit_trail_setting_container']" position="after">
                <block title="Xero Webhook Configuration" id="xero_webhook_conf_block">
                    <setting id="xero_webhook_settings" help="Add Xero Webhook Key">
                        <field name="xero_webhook_key"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>