<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View sale.order form -->
    <record id="view_sale_order_form" model="ir.ui.view">
        <field name="name">view.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
              <div class="alert alert-warning text-start d-inline-flex"
                  invisible="is_xero_contact or is_export_xero_contact"
                  role="alert">Warning! This Contact is not linked with XERO.</div>
            </xpath>
        </field>
    </record>

  </odoo>