<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View purchase.order form -->
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
              <div class="alert alert-warning text-start d-inline-flex"
                  invisible="is_xero_contact or is_export_xero_contact"
                  role="alert">Warning! This Contact is not linked with XERO.</div>
            </xpath>
        </field>
    </record>


    <!-- View purchase.order form -->
    <record id="xero_customization.xero_connector_po_order_form_extend" model="ir.ui.view">
        <field name="name">xero.connector.po.order.form.extend</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="sync_xero_connector.xero_connector_po_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='xero_order_line_id']" position="attributes">
              <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

  </odoo>