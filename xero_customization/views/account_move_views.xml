<?xml version="1.0" encoding="utf-8"?>
  <odoo>

    <!-- View account.move list -->

    <record id="view_xero_account_move_list" model="ir.ui.view">
      <field name="name">view.xero.account.move.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
              <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_xero_bill_account_move_list" model="ir.ui.view">
      <field name="name">view.xero.bill.account.move.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
              <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>
      
    <!-- View account.move form -->
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

          <xpath expr="//form" position="attributes">
            <attribute name="create">0</attribute>
          </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
              <div class="alert alert-warning text-start d-inline-flex"
                  invisible="is_xero_contact or is_export_xero_contact"
                  role="alert">Warning! This Contact is not linked with XERO.</div>
            </xpath>

            <xpath expr="//page[@name='other_info']" position="inside">
              <group name="xero_checks" string="Xero Checks">
                <field name="is_export_move"/>
              </group>
            </xpath>

            <!-- For Invoices -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
              <div class="alert alert-success text-start d-inline-flex"
                  invisible="not xero_invoice_id or move_type != 'out_invoice'"
                  role="alert">This Invoice has been exported to Xero.</div>
              <div class="alert alert-danger text-start d-inline-flex"
                  invisible="xero_invoice_id or move_type != 'out_invoice'"
                  role="alert">This Invoice has not been exported to Xero yet.</div>
            </xpath>

            <!-- For Bills -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
              <div class="alert alert-success text-start d-inline-flex"
                  invisible="not xero_invoice_id or move_type != 'in_invoice'"
                  role="alert">This Bill has been exported to Xero.</div>
              <div class="alert alert-danger text-start d-inline-flex"
                  invisible="xero_invoice_id or move_type != 'in_invoice'"
                  role="alert">This Bill has not been exported to Xero yet.</div>
            </xpath>

            <xpath expr="//page[@name='other_info']" position="after">
              <page name="xero_details" string="XERO Details">
                <group>
                  <field name="xero_invoice_id"/>
                </group>
              </page>

            </xpath>
        </field>
    </record>

    <!-- View account.move kanban -->

    <record id="view_xero_account_move_kanban" model="ir.ui.view">
      <field name="name">view.xero.account.move.kanban</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
              <attribute name="create">0</attribute>
            </xpath>
        </field>
    </record>

  </odoo>