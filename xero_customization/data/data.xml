<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record forcecreate="True" id="ir_cron_automatic_import_data_contacts" model="ir.cron">
        <field name="name">Automatic Import Contacts (XERO -> ODOO)</field>
        <field name="model_id" ref="model_xero_account"/>
        <field name="active" eval="False" />
        <field name="user_id" ref="base.user_root" />
        <field name="state">code</field>
        <field name="code">model.automatic_import_contacts()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- <field name="numbercall">-1</field> -->
        <!-- <field name="doall" eval="False"/> -->
    </record>

    <record forcecreate="True" id="ir_cron_process_webhook_queue" model="ir.cron">
        <field name="name">Process Xero Webhook Queue</field>
        <field name="model_id" ref="model_xero_webhook_queue"/>
        <field name="active" eval="False" />
        <field name="user_id" ref="base.user_root" />
        <field name="state">code</field>
        <field name="code">model.process_events()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <!-- <field name="numbercall">-1</field> -->
        <!-- <field name="doall" eval="False"/> -->
    </record>
</odoo>