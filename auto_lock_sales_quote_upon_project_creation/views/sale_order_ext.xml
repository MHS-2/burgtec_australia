            <xpath expr="//div[@name='old_data_warning']" position="replace">
                <div name="old_data_warning" class="row" invisible="not is_old_data">
                    <div class="col-1">
                        <i class="fa fa-exclamation-triangle fa-3x text-danger" title="danger"
                           aria-hidden="true"></i>
                    </div>
                    <div class="col-10 alert alert-danger text-center d-inline-flex"
                         role="alert">
                        <strong>Warning:</strong>
                        <span class="mx-2">Deleting Products May Affect the BOM Components and Their Lines.</span>
                    </div>
                    <div class="col-1 text-end" invisible="(not is_frozen_due_to_project_creation and quote_type == 'sales_quote') or (not freeze_sale_order and quote_type == 'project_quote')">
                        <i class="fa fa-lock fa-3x text-info" title="Quote Locked"
                           aria-hidden="true"></i>
                    </div>
                </div>

                <div name="old_data_warning" class="row" invisible="is_old_data or ((not is_frozen_due_to_project_creation and quote_type == 'sales_quote') or (not freeze_sale_order and quote_type == 'project_quote'))">
                    <div class="col-1"></div>
                    <div class="col-10"></div>
                    <div class="col-1 text-end">
                        <i class="fa fa-lock fa-3x text-info" title="Quote Locked"
                           aria-hidden="true"></i>
                    </div>
                </div>

