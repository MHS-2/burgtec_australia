    <record id="auto_lock_sales_quote_upon_project_creation.sale_order_search_view_ext" model="ir.ui.view">
        <field name="name">auto.lock.sales.quote.upon.project.creation.sale.order.search.view.ext</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='filter_create_date']" position="after">
                <separator/>
                <filter string="Freeze Project" name="deal_stage_project_freeze_filter"
                        domain="[('deal_stage_project_freeze', '=',True)]"/>
                <filter string="Freeze Sale Order" name="freeze_sale_order_filter"
                        domain="[('freeze_sale_order', '=',True)]"/>
                <filter string="Freeze Due Project Creation" name="is_frozen_due_to_project_creation_filter"
                        domain="[('is_frozen_due_to_project_creation', '=',True)]"/>
                <separator/>
                <filter string="Not Freeze" name="not_freeze_filter"
                        domain="[('deal_stage_project_freeze', '!=',True), ('freeze_sale_order', '!=',True), ('is_frozen_due_to_project_creation', '!=',True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>


