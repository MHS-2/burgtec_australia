<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List  View for Components -->
    <record id="line_item_status_view_list" model="ir.ui.view">
        <field name="name">line.item.status.view.list</field>
        <field name="model">line.item.status</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="status_name"/>
                <field name="status_quantity"/>
                <field name="planning_screen_id"/>
                <field name="sale_quote_planning_screen_id"/>
                <field name="crm_lead_id"/>
            </list>
        </field>
    </record>


    <record id="action_line_item_status_view_list" model="ir.actions.act_window">
        <field name="name">Line Item Status</field>
        <field name="res_model">line.item.status</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sale_order_bom_component_line"
              name="Line Item Status"
              action="action_line_item_status_view_list"
              parent="sale.menu_sales_config"
              sequence="999"/>

</odoo>
