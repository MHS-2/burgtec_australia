<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- Nscr Selection Wizard Form View -->
        <record id="view_component_existing_nscr_selection_wizard_form" model="ir.ui.view">
            <field name="name">component.existing.nscr.selection.form</field>
            <field name="model">component.existing.nscr.selection</field>
            <field name="arch" type="xml">
                <form string="Existing NSCR Selecton">
                    <sheet>
                        <group>
                            <group>
                                <field name="product_component_id" invisible="1"/>
                                <field name="nscr_id"  domain="[('product_component_id', '=', [product_component_id])]" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_assign_entry" string="Confirm" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_component_existing_nscr_selection_wizard" model="ir.actions.act_window">
            <field name="name">Existing Nscr Selection</field>
            <field name="res_model">component.existing.nscr.selection</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_component_existing_nscr_selection_wizard_form"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>