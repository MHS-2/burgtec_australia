<?xml version="1.0" encoding="utf-8"?>
  <odoo>
      
    <!-- View product.product form -->
    <record id="burgtec_registers_customization.view_product_product_form" model="ir.ui.view">
        <field name="name">burgtec_registers_customization.view.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='old_product_variant_name']" position="after">
              <field name="is_indent" string="Indent" help="If this product is selected as indent"/>
            </xpath>
        </field>
    </record>

  </odoo>